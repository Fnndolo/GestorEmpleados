model Documento {
  id               String               @id @default(uuid(7)) @db.Uuid
  entidadTipo      String               @map("entidad_tipo")
  entidadId        String               @map("entidad_id") @db.Uuid
  tipoDocumentoId  String?              @map("tipo_documento_id") @db.Uuid
  tipoDocumento    TipoDocumento?       @relation(fields: [tipoDocumentoId], references: [id])
  nombre           String
  descripcion      String?
  bucket           String               @default("documentos")
  storagePath      String               @map("storage_path")
  mimeType         String               @map("mime_type")
  tamanoBytes      Int                  @map("tamano_bytes")
  sha256           String?              // huella SHA-256 (hex) del archivo: sello de integridad
