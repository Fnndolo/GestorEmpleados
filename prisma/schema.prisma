}

// Plantilla de cuenta de cobro editable por el administrador (logo, textos, varias)
model PlantillaCuentaCobro {
  id          String   @id @default(uuid(7)) @db.Uuid
  nombre      String // "Días laborados", "Bonos", "Servicios"…
  logoPath    String?  @map("logo_path")
  encabezado  String? // texto sobre el cuerpo (ciudad, fecha, destinatario…)
