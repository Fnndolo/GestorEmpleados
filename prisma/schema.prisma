  estado        EstadoVacaciones @default(SOLICITADA)
  observaciones String?
  solicitudId   String?          @map("solicitud_id") @db.Uuid // origen: solicitud de autoservicio
  // Periodo de nómina que pagó estas vacaciones por adelantado (antes de la salida).
