// Esquema Prisma — Plataforma de Gestión Humana, Jurídica y SST · KUPOCELL S.A.S.
// Convención: modelos en español PascalCase → tablas snake_case (ver docs/diseno/d1_datamodel.md).
// Excepción: User/Session/Account/Verification los gestiona Better Auth (veredicto C2).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ═══════════════════════════════════════════════════════════════════════════
// AUTENTICACIÓN (Better Auth) — User extendido con campos de la plataforma
// ═══════════════════════════════════════════════════════════════════════════

enum EstadoUsuario {
  ACTIVO
  INACTIVO
  BLOQUEADO

  @@map("estado_usuario")
}

model User {
  id            String   @id @default(uuid(7)) @db.Uuid
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Plugin admin de Better Auth
  role       String?   @default("user")
  banned     Boolean?  @default(false)
  banReason  String?   @map("ban_reason")
  banExpires DateTime? @map("ban_expires")

  // Campos de la plataforma
  rolId                String        @map("rol_id") @db.Uuid
  rol                  Rol           @relation(fields: [rolId], references: [id])
  estado               EstadoUsuario @default(ACTIVO)
  debeCambiarPassword  Boolean       @default(true) @map("debe_cambiar_password")
  telefonoE164         String?       @map("telefono_e164")
  whatsappOptIn        Boolean       @default(false) @map("whatsapp_opt_in")
  whatsappOptInFecha   DateTime?     @map("whatsapp_opt_in_fecha")
  ultimoAcceso         DateTime?     @map("ultimo_acceso")

  sessions    Session[]
  accounts    Account[]
  sedes       UsuarioSede[]
  colaborador Colaborador?

  @@map("user")
}

model Session {
  id        String   @id @default(uuid(7)) @db.Uuid
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  impersonatedBy String? @map("impersonated_by")

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(uuid(7)) @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(uuid(7)) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verification")
}

// ═══════════════════════════════════════════════════════════════════════════
// RBAC — roles con matriz de permisos editable, alcance por permiso (C13)
// ═══════════════════════════════════════════════════════════════════════════

enum AccionPermiso {
  VER
  CREAR
  EDITAR
  ELIMINAR
  APROBAR
  EXPORTAR

  @@map("accion_permiso")
}

enum AlcanceDatos {
  TODAS_SEDES
  SEDES_ASIGNADAS
  EQUIPO
  PROPIO

  @@map("alcance_datos")
}

model Rol {
  id          String       @id @default(uuid(7)) @db.Uuid
  nombre      String       @unique
  descripcion String?
  esSistema   Boolean      @default(false) @map("es_sistema")
  creadoEn    DateTime     @default(now()) @map("creado_en")
  actualizadoEn DateTime   @updatedAt @map("actualizado_en")

  permisos RolPermiso[]
  usuarios User[]

  @@map("rol")
}

// `modulo` es String validado contra constantes tipadas (src/lib/permisos/modulos.ts)
// para soportar módulos personalizados con clave `custom:{slug}` (veredicto C13).
model RolPermiso {
  id      String        @id @default(uuid(7)) @db.Uuid
  rolId   String        @map("rol_id") @db.Uuid
  rol     Rol           @relation(fields: [rolId], references: [id], onDelete: Cascade)
  modulo  String
  accion  AccionPermiso
  alcance AlcanceDatos  @default(TODAS_SEDES)

  @@unique([rolId, modulo, accion])
  @@map("rol_permiso")
}

model UsuarioSede {
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  sedeId String @map("sede_id") @db.Uuid
  sede   Sede   @relation(fields: [sedeId], references: [id], onDelete: Cascade)

  @@id([userId, sedeId])
  @@map("usuario_sede")
}

// ═══════════════════════════════════════════════════════════════════════════
// SEDES / CIUDADES — separación transversal exigida por requerimiento 2.7
// ═══════════════════════════════════════════════════════════════════════════

model Ciudad {
  id           String  @id @default(uuid(7)) @db.Uuid
  nombre       String
  departamento String
  codigoDane   String? @map("codigo_dane")
  creadoEn     DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  sedes         Sede[]
  colaboradores Colaborador[]

  @@unique([nombre, departamento])
  @@map("ciudad")
}

model Sede {
  id          String  @id @default(uuid(7)) @db.Uuid
  nombre      String  @unique
  ciudadId    String  @map("ciudad_id") @db.Uuid
  ciudad      Ciudad  @relation(fields: [ciudadId], references: [id])
  direccion   String
  telefono    String?
  esPrincipal Boolean @default(false) @map("es_principal")
  activa      Boolean @default(true)
  creadoEn    DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  usuarios      UsuarioSede[]
  colaboradores Colaborador[]
  contratos     Contrato[]
  contratosOps  ContratoOps[]

  @@map("sede")
}

// ═══════════════════════════════════════════════════════════════════════════
// EMPRESA — singleton de configuración
// ═══════════════════════════════════════════════════════════════════════════

model ConfiguracionEmpresa {
  id                 String  @id @default(uuid(7)) @db.Uuid
  razonSocial        String  @map("razon_social")
  nombreComercial    String  @map("nombre_comercial")
  nit                String
  representanteLegal String  @map("representante_legal")
  emailContacto      String? @map("email_contacto")
  telefono           String?
  direccion          String?
  sitioWeb           String? @map("sitio_web")
  logoUrl            String? @map("logo_url")
  // Días hábiles: el sábado cuenta como hábil salvo configuración contraria (C6)
  sabadoHabil        Boolean @default(true) @map("sabado_habil")
  actualizadoEn      DateTime @updatedAt @map("actualizado_en")

  @@map("configuracion_empresa")
}

// ═══════════════════════════════════════════════════════════════════════════
// AUDITORÍA — requerimiento general 2.5: quién creó/modificó/eliminó y cuándo
// ═══════════════════════════════════════════════════════════════════════════

enum AccionAuditoria {
  CREAR
  EDITAR
  ELIMINAR
  LOGIN
  LOGOUT
  ACCESO
  EXPORTAR

  @@map("accion_auditoria")
}

model AuditLog {
  id         String          @id @default(uuid(7)) @db.Uuid
  creadoEn   DateTime        @default(now()) @map("creado_en")
  userId     String?         @map("user_id") @db.Uuid
  userEmail  String?         @map("user_email")
  accion     AccionAuditoria
  modelo     String
  registroId String?         @map("registro_id")
  // Diff JSON { campo: { antes, despues } } con campos sensibles redactados
  diff       Json?
  descripcion String?
  ip         String?

  @@index([modelo, registroId])
  @@index([userId])
  @@map("audit_log")
}

// ═══════════════════════════════════════════════════════════════════════════
// CATÁLOGOS — entidades de seguridad social, bancos, estructura organizacional
// ═══════════════════════════════════════════════════════════════════════════

enum TipoEntidadSS {
  EPS
  ARL
  AFP
  FONDO_CESANTIAS
  CAJA_COMPENSACION

  @@map("tipo_entidad_ss")
}

model EntidadSeguridadSocial {
  id     String        @id @default(uuid(7)) @db.Uuid
  tipo   TipoEntidadSS
  nombre String
  codigo String? // código PILA del operador
  activa Boolean       @default(true)

  colaboradoresEps            Colaborador[] @relation("ColEps")
  colaboradoresArl            Colaborador[] @relation("ColArl")
  colaboradoresAfp            Colaborador[] @relation("ColAfp")
  colaboradoresFondoCesantias Colaborador[] @relation("ColFondoCesantias")
  colaboradoresCaja           Colaborador[] @relation("ColCaja")

  @@unique([tipo, nombre])
  @@map("entidad_seguridad_social")
}

model Banco {
  id            String        @id @default(uuid(7)) @db.Uuid
  nombre        String        @unique
  codigoAch     String?       @map("codigo_ach")
  activo        Boolean       @default(true)
  colaboradores Colaborador[]

  @@map("banco")
}

enum ClaseRiesgoArl {
  I
  II
  III
  IV
  V

  @@map("clase_riesgo_arl")
}

model Area {
  id            String       @id @default(uuid(7)) @db.Uuid
  nombre        String       @unique
  padreId       String?      @map("padre_id") @db.Uuid
  padre         Area?        @relation("AreaJerarquia", fields: [padreId], references: [id])
  hijas         Area[]       @relation("AreaJerarquia")
  responsableId String?      @map("responsable_id") @db.Uuid
  responsable   Colaborador? @relation("AreaResponsable", fields: [responsableId], references: [id])
  activa        Boolean      @default(true)
  creadoEn      DateTime     @default(now()) @map("creado_en")
  actualizadoEn DateTime     @updatedAt @map("actualizado_en")

  cargos        Cargo[]
  colaboradores Colaborador[]

  @@map("area")
}

model Cargo {
  id                 String          @id @default(uuid(7)) @db.Uuid
  nombre             String
  areaId             String          @map("area_id") @db.Uuid
  area               Area            @relation(fields: [areaId], references: [id])
  nivel              String? // directivo / coordinación / operativo…
  funciones          String? // alimenta certificación CON_FUNCIONES
  claseRiesgoDefecto ClaseRiesgoArl? @map("clase_riesgo_defecto")
  activo             Boolean         @default(true)
  creadoEn           DateTime        @default(now()) @map("creado_en")
  actualizadoEn      DateTime        @updatedAt @map("actualizado_en")

  colaboradores Colaborador[]
  contratos     Contrato[]

  @@unique([nombre, areaId])
  @@map("cargo")
}

// ═══════════════════════════════════════════════════════════════════════════
// COLABORADORES — ficha completa (requerimiento 3.1)
// ═══════════════════════════════════════════════════════════════════════════

enum TipoDocumentoIdentidad {
  CC
  CE
  TI
  PASAPORTE
  PPT
  NIT

  @@map("tipo_documento_identidad")
}

enum Genero {
  MASCULINO
  FEMENINO
  OTRO
  PREFIERE_NO_DECIR

  @@map("genero")
}

enum EstadoCivil {
  SOLTERO
  CASADO
  UNION_LIBRE
  SEPARADO
  DIVORCIADO
  VIUDO

  @@map("estado_civil")
}

enum GrupoSanguineo {
  A_POS
  A_NEG
  B_POS
  B_NEG
  AB_POS
  AB_NEG
  O_POS
  O_NEG

  @@map("grupo_sanguineo")
}

enum NivelEducativo {
  PRIMARIA
  BACHILLER
  TECNICO
  TECNOLOGO
  PREGRADO
  ESPECIALIZACION
  MAESTRIA
  DOCTORADO

  @@map("nivel_educativo")
}

enum TipoCuentaBancaria {
  AHORROS
  CORRIENTE
  BILLETERA_DIGITAL

  @@map("tipo_cuenta_bancaria")
}

enum TipoVinculo {
  TERMINO_INDEFINIDO
  TERMINO_FIJO
  OBRA_LABOR
  APRENDIZ_SENA
  OPS
  PRACTICANTE

  @@map("tipo_vinculo")
}

enum ModalidadTrabajo {
  PRESENCIAL
  REMOTO
  HIBRIDO
  TELETRABAJO

  @@map("modalidad_trabajo")
}

enum EstadoColaborador {
  ACTIVO
  INACTIVO
  RETIRADO

  @@map("estado_colaborador")
}

model Colaborador {
  id                 String                 @id @default(uuid(7)) @db.Uuid
  // Identificación
  tipoDocumento      TipoDocumentoIdentidad @map("tipo_documento")
  numeroDocumento    String                 @map("numero_documento")
  fechaExpedicionDoc DateTime?              @map("fecha_expedicion_doc") @db.Date
  lugarExpedicionDoc String?                @map("lugar_expedicion_doc")
  nombres            String
  apellidos          String
  fechaNacimiento    DateTime?              @map("fecha_nacimiento") @db.Date
  lugarNacimiento    String?                @map("lugar_nacimiento")
  genero             Genero?
  estadoCivil        EstadoCivil?           @map("estado_civil")
  grupoSanguineo     GrupoSanguineo?        @map("grupo_sanguineo")
  fotoPath           String?                @map("foto_path")
  // Contacto
  direccion          String?
  barrio             String?
  ciudadResidenciaId String?                @map("ciudad_residencia_id") @db.Uuid
  ciudadResidencia   Ciudad?                @relation(fields: [ciudadResidenciaId], references: [id])
  celular            String
  telefono           String?
  emailPersonal      String?                @map("email_personal")
  emailCorporativo   String?                @map("email_corporativo")
  // Contacto de emergencia
  emergenciaNombre     String? @map("emergencia_nombre")
  emergenciaParentesco String? @map("emergencia_parentesco")
  emergenciaTelefono   String? @map("emergencia_telefono")
  // Educación
  nivelEducativoMax NivelEducativo?        @map("nivel_educativo_max")
  educacion         EducacionColaborador[]
  // Salud / seguridad social (datos sensibles: módulo colaboradores_salud)
  epsId              String?         @map("eps_id") @db.Uuid
  eps                EntidadSeguridadSocial? @relation("ColEps", fields: [epsId], references: [id])
  afpId              String?         @map("afp_id") @db.Uuid
  afp                EntidadSeguridadSocial? @relation("ColAfp", fields: [afpId], references: [id])
  fondoCesantiasId   String?         @map("fondo_cesantias_id") @db.Uuid
  fondoCesantias     EntidadSeguridadSocial? @relation("ColFondoCesantias", fields: [fondoCesantiasId], references: [id])
  cajaCompensacionId String?         @map("caja_compensacion_id") @db.Uuid
  cajaCompensacion   EntidadSeguridadSocial? @relation("ColCaja", fields: [cajaCompensacionId], references: [id])
  arlId              String?         @map("arl_id") @db.Uuid
  arl                EntidadSeguridadSocial? @relation("ColArl", fields: [arlId], references: [id])
  claseRiesgoArl     ClaseRiesgoArl? @map("clase_riesgo_arl")
  // Datos bancarios
  bancoId      String?             @map("banco_id") @db.Uuid
  banco        Banco?              @relation(fields: [bancoId], references: [id])
  tipoCuenta   TipoCuentaBancaria? @map("tipo_cuenta")
  numeroCuenta String?             @map("numero_cuenta")
  // Organizacional
  tipoVinculo      TipoVinculo      @map("tipo_vinculo")
  sedeId           String           @map("sede_id") @db.Uuid
  sede             Sede             @relation(fields: [sedeId], references: [id])
  areaId           String?          @map("area_id") @db.Uuid
  area             Area?            @relation(fields: [areaId], references: [id])
  cargoId          String?          @map("cargo_id") @db.Uuid
  cargo            Cargo?           @relation(fields: [cargoId], references: [id])
  jefeInmediatoId  String?          @map("jefe_inmediato_id") @db.Uuid
  jefeInmediato    Colaborador?     @relation("JefeInmediato", fields: [jefeInmediatoId], references: [id])
  subordinados     Colaborador[]    @relation("JefeInmediato")
  modalidadTrabajo ModalidadTrabajo @default(PRESENCIAL) @map("modalidad_trabajo")
  fechaIngreso     DateTime         @map("fecha_ingreso") @db.Date
  fechaRetiro      DateTime?        @map("fecha_retiro") @db.Date
  estado           EstadoColaborador @default(ACTIVO)
  // Dotación
  tallaCamisa   String? @map("talla_camisa")
  tallaPantalon String? @map("talla_pantalon")
  tallaCalzado  String? @map("talla_calzado")
  // Acceso
  usuarioId String? @unique @map("usuario_id") @db.Uuid
  usuario   User?   @relation(fields: [usuarioId], references: [id])

  // Búsqueda insensible a tildes/mayúsculas (nombres + apellidos + documento)
  busquedaNormalizada String @default("") @map("busqueda_normalizada")

  areasResponsable      Area[]                 @relation("AreaResponsable")
  contratos             Contrato[]
  contratosOps          ContratoOps[]
  opsSupervisados       ContratoOps[]          @relation("SupervisorOps")
  variacionesSalariales VariacionSalarial[]
  incapacidades         Incapacidad[]
  licencias             Licencia[]
  permisos              Permiso[]
  vacaciones            Vacaciones[]
  bonificaciones        Bonificacion[]
  solicitudes           Solicitud[]
  certificaciones       CertificacionLaboral[]
  liquidaciones         LiquidacionNomina[]
  novedadesHoras        NovedadHoras[]
  comisiones            Comision[]
  prestamos             Prestamo[]
  terminaciones         Terminacion[]

  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  @@unique([tipoDocumento, numeroDocumento])
  @@index([sedeId, estado])
  @@index([areaId])
  @@index([cargoId])
  @@index([jefeInmediatoId])
  @@index([tipoVinculo, estado])
  @@index([busquedaNormalizada])
  @@map("colaborador")
}

model EducacionColaborador {
  id            String         @id @default(uuid(7)) @db.Uuid
  colaboradorId String         @map("colaborador_id") @db.Uuid
  colaborador   Colaborador    @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  nivel         NivelEducativo
  titulo        String
  institucion   String
  fechaGrado    DateTime?      @map("fecha_grado") @db.Date
  enCurso       Boolean        @default(false) @map("en_curso")

  @@index([colaboradorId])
  @@map("educacion_colaborador")
}

// ═══════════════════════════════════════════════════════════════════════════
// GESTIÓN DOCUMENTAL — Documento polimórfico (requerimiento general 2.2)
// ═══════════════════════════════════════════════════════════════════════════

enum NivelAccesoDocumento {
  GENERAL
  RRHH
  SST_MEDICO
  JURIDICA
  ADMIN

  @@map("nivel_acceso_documento")
}

model TipoDocumento {
  id                  String               @id @default(uuid(7)) @db.Uuid
  nombre              String               @unique
  descripcion         String?
  requiereVencimiento Boolean              @default(false) @map("requiere_vencimiento")
  nivelAcceso         NivelAccesoDocumento @default(GENERAL) @map("nivel_acceso")
  // Override de días de alerta (si null, usa el default del tipo de vencimiento)
  diasPrimeraAlerta   Int?                 @map("dias_primera_alerta")
  diasUltimaAlerta    Int?                 @map("dias_ultima_alerta")
  activo              Boolean              @default(true)
  creadoEn            DateTime             @default(now()) @map("creado_en")

  requeridos DocumentoRequerido[]
  documentos Documento[]

  @@map("tipo_documento")
}

model DocumentoRequerido {
  id              String        @id @default(uuid(7)) @db.Uuid
  tipoVinculo     TipoVinculo   @map("tipo_vinculo")
  tipoDocumentoId String        @map("tipo_documento_id") @db.Uuid
  tipoDocumento   TipoDocumento @relation(fields: [tipoDocumentoId], references: [id], onDelete: Cascade)
  obligatorio     Boolean       @default(true)

  @@unique([tipoVinculo, tipoDocumentoId])
  @@map("documento_requerido")
}

model Documento {
  id               String               @id @default(uuid(7)) @db.Uuid
  entidadTipo      String               @map("entidad_tipo")
  entidadId        String               @map("entidad_id") @db.Uuid
  tipoDocumentoId  String?              @map("tipo_documento_id") @db.Uuid
  tipoDocumento    TipoDocumento?       @relation(fields: [tipoDocumentoId], references: [id])
  nombre           String
  descripcion      String?
  bucket           String               @default("documentos")
  storagePath      String               @map("storage_path")
  mimeType         String               @map("mime_type")
  tamanoBytes      Int                  @map("tamano_bytes")
  fechaVencimiento DateTime?            @map("fecha_vencimiento") @db.Date
  nivelAcceso      NivelAccesoDocumento @default(GENERAL) @map("nivel_acceso")
  sedeId           String?              @map("sede_id") @db.Uuid
  subidoPorId      String               @map("subido_por_id") @db.Uuid
  creadoEn         DateTime             @default(now()) @map("creado_en")

  @@index([entidadTipo, entidadId])
  @@index([fechaVencimiento])
  @@index([sedeId])
  @@map("documento")
}

// ═══════════════════════════════════════════════════════════════════════════
// IMPORTACIÓN Y SALDOS INICIALES (requerimiento: importador Excel + V9)
// ═══════════════════════════════════════════════════════════════════════════

enum EstadoImportacion {
  PROCESANDO
  COMPLETADA
  FALLIDA

  @@map("estado_importacion")
}

model ImportacionDatos {
  id            String            @id @default(uuid(7)) @db.Uuid
  tipo          String // "colaboradores"
  archivoNombre String            @map("archivo_nombre")
  storagePath   String?           @map("storage_path")
  totalFilas    Int               @map("total_filas")
  insertadas    Int               @default(0)
  errores       Int               @default(0)
  detalleErrores Json?            @map("detalle_errores")
  estado        EstadoImportacion @default(PROCESANDO)
  importadoPorId String           @map("importado_por_id") @db.Uuid
  creadoEn      DateTime          @default(now()) @map("creado_en")

  @@map("importacion_datos")
}

// Saldo inicial de vacaciones para migración (V9) y ajustes manuales auditados
model AjusteVacaciones {
  id            String   @id @default(uuid(7)) @db.Uuid
  colaboradorId String   @map("colaborador_id") @db.Uuid
  dias          Decimal  @db.Decimal(6, 2) // positivo suma, negativo resta
  motivo        String
  esSaldoInicial Boolean @default(false) @map("es_saldo_inicial")
  fecha         DateTime @default(now())
  registradoPorId String? @map("registrado_por_id") @db.Uuid

  @@index([colaboradorId])
  @@map("ajuste_vacaciones")
}

// ═══════════════════════════════════════════════════════════════════════════
// MOTOR DE VENCIMIENTOS Y ALERTAS — transversal (requerimiento 6.1)
// ═══════════════════════════════════════════════════════════════════════════

// Origen polimórfico del vencimiento (la fuente que lo publicó)
enum OrigenVencimiento {
  DOCUMENTO
  CONTRATO_FIJO
  PERIODO_PRUEBA
  EXAMEN_MEDICO
  PLANILLA_SS_OPS
  OBLIGACION_LEGAL
  POLIZA
  ARRIENDO
  CONVENIO_FINANCIERA
  MARCA
  DOMINIO_WEB
  LICENCIA_SOFTWARE
  COMITE
  ACCION_CORRECTIVA
  EPP
  DOTACION
  MODULO_PERSONALIZADO
  MANUAL

  @@map("origen_vencimiento")
}

enum EstadoVencimiento {
  PENDIENTE
  PRIMERA_ALERTA
  ULTIMA_ALERTA
  VENCIDO
  RESUELTO
  CANCELADO

  @@map("estado_vencimiento")
}

// Configuración de días de alerta por tipo (clave = origen o "GLOBAL").
// Default global: 10 días hábiles y 3 días hábiles antes.
// Calendario legal: 5 días hábiles y 1 día calendario antes.
model ReglaAlerta {
  id                String   @id @default(uuid(7)) @db.Uuid
  clave             String   @unique // "GLOBAL", "OBLIGACION_LEGAL", o un OrigenVencimiento
  descripcion       String
  diasPrimeraAlerta Int      @map("dias_primera_alerta")
  primeraEnHabiles  Boolean  @default(true) @map("primera_en_habiles")
  diasUltimaAlerta  Int      @map("dias_ultima_alerta")
  ultimaEnHabiles   Boolean  @default(true) @map("ultima_en_habiles")
  creadoEn          DateTime @default(now()) @map("creado_en")
  actualizadoEn     DateTime @updatedAt @map("actualizado_en")

  @@map("regla_alerta")
}

model Vencimiento {
  id               String            @id @default(uuid(7)) @db.Uuid
  origen           OrigenVencimiento
  entidadTipo      String            @map("entidad_tipo")
  entidadId        String            @map("entidad_id") @db.Uuid
  titulo           String
  detalle          String?
  fechaVencimiento DateTime          @map("fecha_vencimiento") @db.Date
  sedeId           String?           @map("sede_id") @db.Uuid
  estado           EstadoVencimiento @default(PENDIENTE)
  resueltoEn       DateTime?         @map("resuelto_en")
  creadoEn         DateTime          @default(now()) @map("creado_en")
  actualizadoEn    DateTime          @updatedAt @map("actualizado_en")

  alertas      AlertaVencimiento[]
  responsables ResponsableVencimiento[]

  @@unique([entidadTipo, entidadId, origen])
  @@index([estado, fechaVencimiento])
  @@index([sedeId, estado])
  @@map("vencimiento")
}

// Responsables que reciben la alerta (usuario y/o rol; principal o copia)
model ResponsableVencimiento {
  id            String      @id @default(uuid(7)) @db.Uuid
  vencimientoId String      @map("vencimiento_id") @db.Uuid
  vencimiento   Vencimiento @relation(fields: [vencimientoId], references: [id], onDelete: Cascade)
  userId        String?     @map("user_id") @db.Uuid
  rol           String? // nombre de rol (todos los usuarios con ese rol)
  esPrincipal   Boolean     @default(true) @map("es_principal")

  @@index([vencimientoId])
  @@map("responsable_vencimiento")
}

enum PasoAlerta {
  PRIMERA
  ULTIMA
  VENCIDO

  @@map("paso_alerta")
}

// Pasos materializados de alerta (idempotencia estructural: una fila por paso)
model AlertaVencimiento {
  id              String      @id @default(uuid(7)) @db.Uuid
  vencimientoId   String      @map("vencimiento_id") @db.Uuid
  vencimiento     Vencimiento @relation(fields: [vencimientoId], references: [id], onDelete: Cascade)
  paso            PasoAlerta
  fechaProgramada DateTime    @map("fecha_programada") @db.Date
  despachada      Boolean     @default(false)
  despachadaEn    DateTime?   @map("despachada_en")

  @@unique([vencimientoId, paso])
  @@index([despachada, fechaProgramada])
  @@map("alerta_vencimiento")
}

// Festivos decretados fuera del calendario Emiliani (ADD) o removidos (REMOVE)
enum TipoExcepcionFestivo {
  ADD
  REMOVE

  @@map("tipo_excepcion_festivo")
}

model FestivoExcepcion {
  id     String               @id @default(uuid(7)) @db.Uuid
  fecha  DateTime             @unique @db.Date
  tipo   TipoExcepcionFestivo
  nombre String?

  @@map("festivo_excepcion")
}

// ═══════════════════════════════════════════════════════════════════════════
// NOTIFICACIONES — centro in-app + outbox (correo / WhatsApp preparado)
// ═══════════════════════════════════════════════════════════════════════════

model Notificacion {
  id          String   @id @default(uuid(7)) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  titulo      String
  mensaje     String
  enlace      String?
  leida       Boolean  @default(false)
  // Evita duplicar la misma notificación si el cron corre dos veces
  dedupeKey   String   @unique @map("dedupe_key")
  creadoEn    DateTime @default(now()) @map("creado_en")

  @@index([userId, leida, creadoEn])
  @@map("notificacion")
}

enum CanalMensaje {
  EMAIL
  WHATSAPP

  @@map("canal_mensaje")
}

enum EstadoMensaje {
  EN_COLA
  ENVIADO
  FALLIDO
  DESCARTADO

  @@map("estado_mensaje")
}

// Outbox de mensajes salientes (idempotente por dedupeKey, con reintentos)
model MensajeSaliente {
  id          String        @id @default(uuid(7)) @db.Uuid
  canal       CanalMensaje
  destino     String // email o teléfono E.164
  asunto      String?
  cuerpo      String
  estado      EstadoMensaje @default(EN_COLA)
  intentos    Int           @default(0)
  proveedorRef String?      @map("proveedor_ref")
  error       String?
  dedupeKey   String        @unique @map("dedupe_key")
  creadoEn    DateTime      @default(now()) @map("creado_en")
  enviadoEn   DateTime?     @map("enviado_en")

  @@index([estado])
  @@map("mensaje_saliente")
}

// ═══════════════════════════════════════════════════════════════════════════
// CONTRATACIÓN LABORAL (requerimiento 3.2 / 6.3)
// ═══════════════════════════════════════════════════════════════════════════

enum TipoContratoLaboral {
  TERMINO_FIJO
  TERMINO_INDEFINIDO
  OBRA_LABOR
  APRENDIZAJE_SENA
  PRACTICA

  @@map("tipo_contrato_laboral")
}

enum TipoSalario {
  ORDINARIO
  INTEGRAL

  @@map("tipo_salario")
}

enum Jornada {
  TIEMPO_COMPLETO
  MEDIO_TIEMPO
  POR_DIAS

  @@map("jornada")
}

enum EstadoContrato {
  BORRADOR
  ACTIVO
  SUSPENDIDO
  TERMINADO

  @@map("estado_contrato")
}

enum EtapaAprendizaje {
  LECTIVA
  PRODUCTIVA

  @@map("etapa_aprendizaje")
}

model Contrato {
  id                 String              @id @default(uuid(7)) @db.Uuid
  numero             String              @unique
  colaboradorId      String              @map("colaborador_id") @db.Uuid
  colaborador        Colaborador         @relation(fields: [colaboradorId], references: [id])
  tipo               TipoContratoLaboral
  cargoId            String?             @map("cargo_id") @db.Uuid
  cargo              Cargo?              @relation(fields: [cargoId], references: [id])
  sedeId             String              @map("sede_id") @db.Uuid
  sede               Sede                @relation(fields: [sedeId], references: [id])
  jornada            Jornada             @default(TIEMPO_COMPLETO)
  horasSemanales     Int?                @map("horas_semanales")
  modalidadTrabajo   ModalidadTrabajo    @map("modalidad_trabajo")
  salarioBase        Decimal             @map("salario_base") @db.Decimal(14, 2)
  tipoSalario        TipoSalario         @default(ORDINARIO) @map("tipo_salario")
  fechaInicio        DateTime            @map("fecha_inicio") @db.Date
  fechaFin           DateTime?           @map("fecha_fin") @db.Date
  objetoObraLabor    String?             @map("objeto_obra_labor")
  etapaAprendizaje   EtapaAprendizaje?   @map("etapa_aprendizaje")
  apoyoSostenimiento Decimal?            @map("apoyo_sostenimiento") @db.Decimal(14, 2)
  periodoPruebaDias  Int?                @map("periodo_prueba_dias")
  periodoPruebaFin   DateTime?           @map("periodo_prueba_fin") @db.Date
  estado             EstadoContrato      @default(BORRADOR)
  observaciones      String?
  creadoEn           DateTime            @default(now()) @map("creado_en")
  actualizadoEn      DateTime            @updatedAt @map("actualizado_en")

  prorrogas    ProrrogaContrato[]
  otrosis      OtrosiContrato[]
  suspensiones SuspensionContrato[]

  @@index([colaboradorId, estado])
  @@index([tipo, estado, fechaFin])
  @@index([sedeId])
  @@map("contrato")
}

model ProrrogaContrato {
  id          String    @id @default(uuid(7)) @db.Uuid
  contratoId  String    @map("contrato_id") @db.Uuid
  contrato    Contrato  @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  numero      Int
  fechaInicio DateTime  @map("fecha_inicio") @db.Date
  fechaFin    DateTime  @map("fecha_fin") @db.Date
  fechaFirma  DateTime? @map("fecha_firma") @db.Date

  @@unique([contratoId, numero])
  @@map("prorroga_contrato")
}

enum TipoCambioOtrosi {
  SALARIO
  CARGO
  SEDE
  MODALIDAD_TRABAJO
  JORNADA
  FUNCIONES
  DURACION
  OTRO

  @@map("tipo_cambio_otrosi")
}

model OtrosiContrato {
  id                String   @id @default(uuid(7)) @db.Uuid
  contratoId        String   @map("contrato_id") @db.Uuid
  contrato          Contrato @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  numero            Int
  fecha             DateTime @db.Date
  tiposCambio       TipoCambioOtrosi[] @map("tipos_cambio")
  descripcion       String
  valoresAnteriores Json?    @map("valores_anteriores")
  valoresNuevos     Json?    @map("valores_nuevos")

  @@unique([contratoId, numero])
  @@map("otrosi_contrato")
}

enum CausaSuspension {
  SANCION_DISCIPLINARIA
  LICENCIA_NO_REMUNERADA
  FUERZA_MAYOR
  OTRO

  @@map("causa_suspension")
}

// Suspensión del contrato (V1) — afecta días en nómina
model SuspensionContrato {
  id          String          @id @default(uuid(7)) @db.Uuid
  contratoId  String          @map("contrato_id") @db.Uuid
  contrato    Contrato        @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  fechaInicio DateTime        @map("fecha_inicio") @db.Date
  fechaFin    DateTime?       @map("fecha_fin") @db.Date
  causa       CausaSuspension
  descripcion String?
  creadoEn    DateTime        @default(now()) @map("creado_en")

  @@index([contratoId])
  @@map("suspension_contrato")
}

// Variaciones salariales con histórico (requerimiento 3.4)
model VariacionSalarial {
  id             String   @id @default(uuid(7)) @db.Uuid
  colaboradorId  String   @map("colaborador_id") @db.Uuid
  colaborador    Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  salarioAnterior Decimal @map("salario_anterior") @db.Decimal(14, 2)
  salarioNuevo   Decimal  @map("salario_nuevo") @db.Decimal(14, 2)
  fechaVigencia  DateTime @map("fecha_vigencia") @db.Date
  motivo         String?
  creadoEn       DateTime @default(now()) @map("creado_en")

  @@index([colaboradorId])
  @@map("variacion_salarial")
}

// ═══════════════════════════════════════════════════════════════════════════
// CONTRATISTAS OPS (prestación de servicios) — flujo separado de nómina (3.2)
// ═══════════════════════════════════════════════════════════════════════════

enum EstadoContratoOps {
  BORRADOR
  ACTIVO
  TERMINADO

  @@map("estado_contrato_ops")
}

model ContratoOps {
  id            String            @id @default(uuid(7)) @db.Uuid
  numero        String            @unique
  colaboradorId String            @map("colaborador_id") @db.Uuid
  colaborador   Colaborador       @relation(fields: [colaboradorId], references: [id])
  objeto        String
  valorTotal    Decimal           @map("valor_total") @db.Decimal(14, 2)
  valorMensual  Decimal?          @map("valor_mensual") @db.Decimal(14, 2)
  supervisorId  String?           @map("supervisor_id") @db.Uuid
  supervisor    Colaborador?      @relation("SupervisorOps", fields: [supervisorId], references: [id])
  sedeId        String            @map("sede_id") @db.Uuid
  sede          Sede              @relation(fields: [sedeId], references: [id])
  fechaInicio   DateTime          @map("fecha_inicio") @db.Date
  fechaFin      DateTime          @map("fecha_fin") @db.Date
  rut           String?
  estado        EstadoContratoOps @default(ACTIVO)
  creadoEn      DateTime          @default(now()) @map("creado_en")
  actualizadoEn DateTime          @updatedAt @map("actualizado_en")

  entregables   EntregableOps[]
  cuentasCobro  CuentaCobroOps[]

  @@index([colaboradorId, estado])
  @@index([sedeId])
  @@map("contrato_ops")
}

model EntregableOps {
  id           String      @id @default(uuid(7)) @db.Uuid
  contratoOpsId String     @map("contrato_ops_id") @db.Uuid
  contratoOps  ContratoOps @relation(fields: [contratoOpsId], references: [id], onDelete: Cascade)
  descripcion  String
  fechaEntrega DateTime?   @map("fecha_entrega") @db.Date
  cumplido     Boolean     @default(false)

  @@index([contratoOpsId])
  @@map("entregable_ops")
}

enum EstadoCuentaCobro {
  RADICADA
  EN_VERIFICACION_SS
  BLOQUEADA_SS
  APROBADA
  PAGADA
  RECHAZADA

  @@map("estado_cuenta_cobro")
}

enum EstadoVerificacionSS {
  PENDIENTE
  VALIDA
  INVALIDA

  @@map("estado_verificacion_ss")
}

model CuentaCobroOps {
  id            String            @id @default(uuid(7)) @db.Uuid
  contratoOpsId String            @map("contrato_ops_id") @db.Uuid
  contratoOps   ContratoOps       @relation(fields: [contratoOpsId], references: [id])
  numero        String
  periodo       String // "2026-06"
  valor         Decimal           @db.Decimal(14, 2)
  fechaRadicacion DateTime        @map("fecha_radicacion") @db.Date
  estado        EstadoCuentaCobro @default(RADICADA)
  observaciones String?
  fechaPago     DateTime?         @map("fecha_pago") @db.Date
  creadoEn      DateTime          @default(now()) @map("creado_en")
  actualizadoEn DateTime          @updatedAt @map("actualizado_en")

  soporteSs SoporteSsOps?

  @@unique([contratoOpsId, periodo])
  @@index([estado])
  @@map("cuenta_cobro_ops")
}

// Verificación obligatoria del pago de seguridad social del independiente (legal)
model SoporteSsOps {
  id                 String               @id @default(uuid(7)) @db.Uuid
  cuentaCobroId      String               @unique @map("cuenta_cobro_id") @db.Uuid
  cuentaCobro        CuentaCobroOps       @relation(fields: [cuentaCobroId], references: [id], onDelete: Cascade)
  operador           String? // operador PILA
  periodoCotizado    String               @map("periodo_cotizado")
  ibcDeclarado       Decimal?             @map("ibc_declarado") @db.Decimal(14, 2)
  estadoVerificacion EstadoVerificacionSS @default(PENDIENTE) @map("estado_verificacion")
  verificadoPorId    String?              @map("verificado_por_id") @db.Uuid
  verificadoEn       DateTime?            @map("verificado_en")
  observaciones      String?

  @@map("soporte_ss_ops")
}

// Plantillas de documentos (contratos, cartas) por modalidad — Jurídica las usa
model PlantillaDocumento {
  id          String   @id @default(uuid(7)) @db.Uuid
  nombre      String
  categoria   String // "contrato", "carta_preaviso", "certificacion"…
  tipoVinculo TipoVinculo?  @map("tipo_vinculo")
  contenido   String // texto con variables {{colaborador.nombres}}…
  activa      Boolean  @default(true)
  creadoEn    DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  @@map("plantilla_documento")
}

// ═══════════════════════════════════════════════════════════════════════════
// NOVEDADES (requerimiento 3.4)
// ═══════════════════════════════════════════════════════════════════════════

enum TipoIncapacidad {
  ENFERMEDAD_GENERAL
  ACCIDENTE_TRABAJO
  ENFERMEDAD_LABORAL
  LICENCIA_MATERNIDAD
  LICENCIA_PATERNIDAD

  @@map("tipo_incapacidad")
}

model Incapacidad {
  id            String          @id @default(uuid(7)) @db.Uuid
  colaboradorId String          @map("colaborador_id") @db.Uuid
  colaborador   Colaborador     @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  tipo          TipoIncapacidad
  fechaInicio   DateTime        @map("fecha_inicio") @db.Date
  fechaFin      DateTime        @map("fecha_fin") @db.Date
  dias          Int
  diagnosticoCie10 String?      @map("diagnostico_cie10") // dato clínico sensible (Ley 1581)
  entidad       String? // EPS/ARL que la emite
  esProrroga    Boolean         @default(false) @map("es_prorroga")
  observaciones String?
  creadoEn      DateTime        @default(now()) @map("creado_en")

  @@index([colaboradorId])
  @@map("incapacidad")
}

enum TipoLicencia {
  MATERNIDAD
  PATERNIDAD
  LUTO
  CALAMIDAD
  MATRIMONIO
  ESTUDIO
  NO_REMUNERADA
  DIA_DE_LA_FAMILIA
  OTRA

  @@map("tipo_licencia")
}

model Licencia {
  id            String       @id @default(uuid(7)) @db.Uuid
  colaboradorId String       @map("colaborador_id") @db.Uuid
  colaborador   Colaborador  @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  tipo          TipoLicencia
  fechaInicio   DateTime     @map("fecha_inicio") @db.Date
  fechaFin      DateTime     @map("fecha_fin") @db.Date
  dias          Int
  remunerada    Boolean      @default(true)
  observaciones String?
  creadoEn      DateTime     @default(now()) @map("creado_en")

  @@index([colaboradorId])
  @@map("licencia")
}

model Permiso {
  id            String      @id @default(uuid(7)) @db.Uuid
  colaboradorId String      @map("colaborador_id") @db.Uuid
  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  fecha         DateTime    @db.Date
  horas         Decimal?    @db.Decimal(4, 1)
  diaCompleto   Boolean     @default(false) @map("dia_completo")
  motivo        String
  remunerado    Boolean     @default(true)
  creadoEn      DateTime    @default(now()) @map("creado_en")

  @@index([colaboradorId])
  @@map("permiso")
}

enum EstadoVacaciones {
  SOLICITADA
  APROBADA
  EN_DISFRUTE
  DISFRUTADA
  RECHAZADA
  CANCELADA

  @@map("estado_vacaciones")
}

model Vacaciones {
  id            String           @id @default(uuid(7)) @db.Uuid
  colaboradorId String           @map("colaborador_id") @db.Uuid
  colaborador   Colaborador      @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  fechaInicio   DateTime         @map("fecha_inicio") @db.Date
  fechaFin      DateTime         @map("fecha_fin") @db.Date
  diasHabiles   Decimal          @map("dias_habiles") @db.Decimal(5, 2)
  estado        EstadoVacaciones @default(SOLICITADA)
  observaciones String?
  creadoEn      DateTime         @default(now()) @map("creado_en")

  @@index([colaboradorId, estado])
  @@map("vacaciones")
}

enum EstadoBonificacion {
  PENDIENTE
  PAGADO

  @@map("estado_bonificacion")
}

model Bonificacion {
  id                  String             @id @default(uuid(7)) @db.Uuid
  colaboradorId       String             @map("colaborador_id") @db.Uuid
  colaborador         Colaborador        @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  concepto            String
  valor               Decimal            @db.Decimal(14, 2)
  constitutivoSalario Boolean            @default(false) @map("constitutivo_salario")
  estadoPago          EstadoBonificacion @default(PENDIENTE) @map("estado_pago")
  fechaPago           DateTime?          @map("fecha_pago") @db.Date
  observaciones       String?
  creadoEn            DateTime           @default(now()) @map("creado_en")

  @@index([colaboradorId])
  @@map("bonificacion")
}

// ═══════════════════════════════════════════════════════════════════════════
// AUTOSERVICIO Y APROBACIONES (requerimiento 3.5)
// ═══════════════════════════════════════════════════════════════════════════

enum TipoSolicitud {
  VACACIONES
  PERMISO
  CERTIFICACION_LABORAL
  LICENCIA
  OTRA

  @@map("tipo_solicitud")
}

enum EstadoSolicitud {
  PENDIENTE
  EN_APROBACION
  APROBADA
  RECHAZADA
  CANCELADA

  @@map("estado_solicitud")
}

model Solicitud {
  id            String          @id @default(uuid(7)) @db.Uuid
  colaboradorId String          @map("colaborador_id") @db.Uuid
  colaborador   Colaborador     @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  tipo          TipoSolicitud
  datos         Json // contenido específico (fechas de vacaciones, tipo de certificación…)
  estado        EstadoSolicitud @default(EN_APROBACION)
  resultado     String? // referencia al objeto creado o motivo de rechazo
  creadoEn      DateTime        @default(now()) @map("creado_en")
  actualizadoEn DateTime        @updatedAt @map("actualizado_en")

  pasos PasoAprobacion[]

  @@index([colaboradorId, estado])
  @@index([estado])
  @@map("solicitud")
}

enum EstadoPasoAprobacion {
  PENDIENTE
  APROBADO
  RECHAZADO
  OMITIDO

  @@map("estado_paso_aprobacion")
}

model PasoAprobacion {
  id            String               @id @default(uuid(7)) @db.Uuid
  solicitudId   String               @map("solicitud_id") @db.Uuid
  solicitud     Solicitud            @relation(fields: [solicitudId], references: [id], onDelete: Cascade)
  orden         Int
  // Rol o usuario que puede resolver este paso (jefe inmediato o RRHH/Subgerencia)
  rolAprobador  String? // "Jefe de área", "Recursos Humanos", "Subgerencia"
  usaJefeInmediato Boolean           @default(false) @map("usa_jefe_inmediato")
  estado        EstadoPasoAprobacion @default(PENDIENTE)
  decididoPorId String?              @map("decidido_por_id") @db.Uuid
  decididoEn    DateTime?            @map("decidido_en")
  comentario    String?

  @@index([solicitudId, orden])
  @@map("paso_aprobacion")
}

// ═══════════════════════════════════════════════════════════════════════════
// CERTIFICACIONES LABORALES (requerimiento 6.7)
// ═══════════════════════════════════════════════════════════════════════════

enum TipoCertificacion {
  SIMPLE
  CON_SALARIO
  CON_FUNCIONES
  ENTIDAD_FINANCIERA

  @@map("tipo_certificacion")
}

enum EstadoCertificacion {
  SOLICITADA
  GENERADA
  ENTREGADA

  @@map("estado_certificacion")
}

model CertificacionLaboral {
  id            String              @id @default(uuid(7)) @db.Uuid
  colaboradorId String              @map("colaborador_id") @db.Uuid
  colaborador   Colaborador         @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  tipo          TipoCertificacion
  dirigidaA     String?             @map("dirigida_a")
  estado        EstadoCertificacion @default(GENERADA)
  documentoId   String?             @map("documento_id") @db.Uuid // PDF guardado
  generadoPorId String?             @map("generado_por_id") @db.Uuid
  creadoEn      DateTime            @default(now()) @map("creado_en")

  @@index([colaboradorId])
  @@map("certificacion_laboral")
}

// ═══════════════════════════════════════════════════════════════════════════
// NÓMINA (requerimiento 3.3) — parámetros con vigencias, conceptos, liquidación
// ═══════════════════════════════════════════════════════════════════════════

// Parámetros legales clave/valor con vigencia (C7): SMMLV, auxilio transporte,
// porcentajes de SS, etc. Los cambios legales no se alinean al año calendario.
model ParametroLegal {
  id            String    @id @default(uuid(7)) @db.Uuid
  clave         String // SMMLV, AUX_TRANSPORTE, SALUD_EMPLEADO, PENSION_EMPLEADO…
  valor         Decimal   @db.Decimal(14, 4)
  vigenciaDesde DateTime  @map("vigencia_desde") @db.Date
  vigenciaHasta DateTime? @map("vigencia_hasta") @db.Date
  fuenteLegal   String    @map("fuente_legal")
  descripcion   String?

  @@index([clave, vigenciaDesde])
  @@map("parametro_legal")
}

enum TipoConcepto {
  DEVENGADO
  DEDUCCION
  PROVISION
  APORTE_PATRONAL

  @@map("tipo_concepto")
}

enum TipoCalculoConcepto {
  VALOR_FIJO
  PORCENTAJE_BASE
  CANTIDAD_POR_VALOR
  SISTEMA // calculado por el motor en código

  @@map("tipo_calculo_concepto")
}

model ConceptoNomina {
  id                  String              @id @default(uuid(7)) @db.Uuid
  codigo              String              @unique
  nombre              String
  tipo                TipoConcepto
  tipoCalculo         TipoCalculoConcepto @default(SISTEMA) @map("tipo_calculo")
  constitutivoSalario Boolean             @default(false) @map("constitutivo_salario")
  afectaIbcSs         Boolean             @default(false) @map("afecta_ibc_ss")
  basePrestaciones    Boolean             @default(false) @map("base_prestaciones")
  baseVacaciones      Boolean             @default(false) @map("base_vacaciones")
  afectaRetefuente    Boolean             @default(false) @map("afecta_retefuente")
  porcentaje          Decimal?            @db.Decimal(8, 4) // para PORCENTAJE_BASE
  valorFijo           Decimal?            @map("valor_fijo") @db.Decimal(14, 2)
  cuentaContable      String?             @map("cuenta_contable")
  esSistema           Boolean             @default(false) @map("es_sistema")
  activo              Boolean             @default(true)
  orden               Int                 @default(100)

  @@map("concepto_nomina")
}

// Tipos de hora extra/recargo con factor (Ley 2466). El factor vigente se siembra
// según la fecha; el clasificador deriva el tipo desde rangos horarios.
model TipoHora {
  id        String   @id @default(uuid(7)) @db.Uuid
  codigo    String // HED, HEN, RN, RD, RND, HEDD, HEND
  nombre    String
  factor    Decimal  @db.Decimal(6, 4) // 1.25 HED, 1.75 HEN, 0.35 RN, 0.80 RD…
  vigenteDesde DateTime @map("vigente_desde") @db.Date
  vigenteHasta DateTime? @map("vigente_hasta") @db.Date

  @@index([codigo, vigenteDesde])
  @@map("tipo_hora")
}

enum TipoPeriodoNomina {
  MENSUAL
  QUINCENAL

  @@map("tipo_periodo_nomina")
}

enum EstadoPeriodoNomina {
  BORRADOR
  CALCULADA
  APROBADA
  CERRADA
  PAGADA

  @@map("estado_periodo_nomina")
}

model PeriodoNomina {
  id                 String              @id @default(uuid(7)) @db.Uuid
  nombre             String // "Junio 2026", "Junio 2026 - 1ra quincena"
  tipo               TipoPeriodoNomina   @default(MENSUAL)
  anio               Int
  mes                Int
  quincena           Int? // 1 o 2 si quincenal
  fechaInicio        DateTime            @map("fecha_inicio") @db.Date
  fechaFin           DateTime            @map("fecha_fin") @db.Date
  diasPeriodo        Int                 @map("dias_periodo") // 15 o 30
  estado             EstadoPeriodoNomina @default(BORRADOR)
  parametrosSnapshot Json?               @map("parametros_snapshot")
  esAjuste           Boolean             @default(false) @map("es_ajuste")
  creadoEn           DateTime            @default(now()) @map("creado_en")
  actualizadoEn      DateTime            @updatedAt @map("actualizado_en")

  liquidaciones LiquidacionNomina[]
  comisiones    Comision[]
  novedadesHoras NovedadHoras[]

  @@map("periodo_nomina")
}

model LiquidacionNomina {
  id              String        @id @default(uuid(7)) @db.Uuid
  periodoId       String        @map("periodo_id") @db.Uuid
  periodo         PeriodoNomina @relation(fields: [periodoId], references: [id], onDelete: Cascade)
  colaboradorId   String        @map("colaborador_id") @db.Uuid
  colaborador     Colaborador   @relation(fields: [colaboradorId], references: [id])
  diasTrabajados  Decimal       @map("dias_trabajados") @db.Decimal(5, 2)
  salarioBase     Decimal       @map("salario_base") @db.Decimal(14, 2)
  ibc             Decimal       @db.Decimal(14, 2)
  totalDevengado  Decimal       @map("total_devengado") @db.Decimal(14, 2)
  totalDeducido   Decimal       @map("total_deducido") @db.Decimal(14, 2)
  neto            Decimal       @db.Decimal(14, 2)
  documentoId     String?       @map("documento_id") @db.Uuid // desprendible PDF
  creadoEn        DateTime      @default(now()) @map("creado_en")

  detalles DetalleNomina[]

  @@unique([periodoId, colaboradorId])
  @@index([colaboradorId])
  @@map("liquidacion_nomina")
}

model DetalleNomina {
  id             String            @id @default(uuid(7)) @db.Uuid
  liquidacionId  String            @map("liquidacion_id") @db.Uuid
  liquidacion    LiquidacionNomina @relation(fields: [liquidacionId], references: [id], onDelete: Cascade)
  conceptoCodigo String            @map("concepto_codigo")
  conceptoNombre String            @map("concepto_nombre")
  tipo           TipoConcepto
  cantidad       Decimal?          @db.Decimal(8, 2)
  base           Decimal?          @db.Decimal(14, 2)
  factor         Decimal?          @db.Decimal(8, 4)
  valor          Decimal           @db.Decimal(14, 2)
  cuentaContable String?           @map("cuenta_contable")

  @@index([liquidacionId])
  @@map("detalle_nomina")
}

model NovedadHoras {
  id            String        @id @default(uuid(7)) @db.Uuid
  colaboradorId String        @map("colaborador_id") @db.Uuid
  colaborador   Colaborador   @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  periodoId     String?       @map("periodo_id") @db.Uuid
  periodo       PeriodoNomina? @relation(fields: [periodoId], references: [id])
  fecha         DateTime      @db.Date
  horaInicio    String        @map("hora_inicio") // "19:00"
  horaFin       String        @map("hora_fin") // "22:00"
  tipoHora      String        @map("tipo_hora") // HED/HEN/RN/RD/RND clasificado
  horas         Decimal       @db.Decimal(5, 2)
  observaciones String?
  creadoEn      DateTime      @default(now()) @map("creado_en")

  @@index([colaboradorId, periodoId])
  @@map("novedad_horas")
}

enum TipoComision {
  VENTA
  RECAUDO

  @@map("tipo_comision")
}

model Comision {
  id            String        @id @default(uuid(7)) @db.Uuid
  colaboradorId String        @map("colaborador_id") @db.Uuid
  colaborador   Colaborador   @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  periodoId     String?       @map("periodo_id") @db.Uuid
  periodo       PeriodoNomina? @relation(fields: [periodoId], references: [id])
  tipo          TipoComision
  baseCalculo   Decimal       @map("base_calculo") @db.Decimal(14, 2)
  valor         Decimal       @db.Decimal(14, 2)
  descripcion   String?
  creadoEn      DateTime      @default(now()) @map("creado_en")

  @@index([colaboradorId, periodoId])
  @@map("comision")
}

enum EstadoPrestamo {
  ACTIVO
  PAGADO
  CANCELADO

  @@map("estado_prestamo")
}

model Prestamo {
  id            String         @id @default(uuid(7)) @db.Uuid
  colaboradorId String         @map("colaborador_id") @db.Uuid
  colaborador   Colaborador    @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  valorTotal    Decimal        @map("valor_total") @db.Decimal(14, 2)
  numeroCuotas  Int            @map("numero_cuotas")
  valorCuota    Decimal        @map("valor_cuota") @db.Decimal(14, 2)
  saldo         Decimal        @db.Decimal(14, 2)
  fechaInicio   DateTime       @map("fecha_inicio") @db.Date
  estado        EstadoPrestamo @default(ACTIVO)
  descripcion   String?
  creadoEn      DateTime       @default(now()) @map("creado_en")

  cuotas CuotaPrestamo[]

  @@index([colaboradorId, estado])
  @@map("prestamo")
}

model CuotaPrestamo {
  id            String    @id @default(uuid(7)) @db.Uuid
  prestamoId    String    @map("prestamo_id") @db.Uuid
  prestamo      Prestamo  @relation(fields: [prestamoId], references: [id], onDelete: Cascade)
  numero        Int
  valor         Decimal   @db.Decimal(14, 2)
  pagada        Boolean   @default(false)
  periodoId     String?   @map("periodo_id") @db.Uuid
  fechaPago     DateTime? @map("fecha_pago") @db.Date

  @@index([prestamoId])
  @@map("cuota_prestamo")
}

// Planilla PILA mensual (registro del pago y su vencimiento)
model PlanillaPila {
  id           String    @id @default(uuid(7)) @db.Uuid
  periodo      String    @unique // "2026-06"
  fechaLimite  DateTime  @map("fecha_limite") @db.Date
  fechaPago    DateTime? @map("fecha_pago") @db.Date
  valorTotal   Decimal?  @map("valor_total") @db.Decimal(14, 2)
  pagada       Boolean   @default(false)
  documentoId  String?   @map("documento_id") @db.Uuid
  creadoEn     DateTime  @default(now()) @map("creado_en")

  @@map("planilla_pila")
}

// ═══════════════════════════════════════════════════════════════════════════
// TERMINACIONES, LIQUIDACIÓN DEFINITIVA Y PAZ Y SALVO (requerimiento 6.2/6.6)
// ═══════════════════════════════════════════════════════════════════════════

enum TipoTerminacion {
  RENUNCIA_VOLUNTARIA
  SIN_JUSTA_CAUSA
  CON_JUSTA_CAUSA
  TERMINACION_ANTICIPADA
  MUTUO_ACUERDO
  VENCIMIENTO_PLAZO
  PERIODO_PRUEBA
  FIN_OPS

  @@map("tipo_terminacion")
}

enum EstadoTerminacion {
  EN_PROCESO
  LIQUIDADA
  CERRADA

  @@map("estado_terminacion")
}

model Terminacion {
  id            String            @id @default(uuid(7)) @db.Uuid
  colaboradorId String            @map("colaborador_id") @db.Uuid
  colaborador   Colaborador       @relation(fields: [colaboradorId], references: [id])
  tipo          TipoTerminacion
  fechaRetiro   DateTime          @map("fecha_retiro") @db.Date
  preavisoDias  Int?              @map("preaviso_dias")
  indemnizacion Decimal?          @db.Decimal(14, 2)
  motivo        String?
  estado        EstadoTerminacion @default(EN_PROCESO)
  creadoEn      DateTime          @default(now()) @map("creado_en")
  actualizadoEn DateTime          @updatedAt @map("actualizado_en")

  liquidacion LiquidacionDefinitiva?
  pazYSalvo   PazYSalvo?

  @@index([colaboradorId])
  @@map("terminacion")
}

model LiquidacionDefinitiva {
  id              String      @id @default(uuid(7)) @db.Uuid
  terminacionId   String      @unique @map("terminacion_id") @db.Uuid
  terminacion     Terminacion @relation(fields: [terminacionId], references: [id], onDelete: Cascade)
  diasLiquidados  Int         @map("dias_liquidados")
  salarioBase     Decimal     @map("salario_base") @db.Decimal(14, 2)
  cesantias       Decimal     @db.Decimal(14, 2)
  interesesCesantias Decimal  @map("intereses_cesantias") @db.Decimal(14, 2)
  prima           Decimal     @db.Decimal(14, 2)
  vacaciones      Decimal     @db.Decimal(14, 2)
  indemnizacion   Decimal     @db.Decimal(14, 2)
  otros           Decimal     @default(0) @db.Decimal(14, 2)
  deducciones     Decimal     @default(0) @db.Decimal(14, 2)
  total           Decimal     @db.Decimal(14, 2)
  detalle         Json?
  documentoId     String?     @map("documento_id") @db.Uuid
  creadoEn        DateTime    @default(now()) @map("creado_en")

  @@map("liquidacion_definitiva")
}

enum EstadoPazYSalvo {
  PENDIENTE
  COMPLETO

  @@map("estado_paz_y_salvo")
}

model PazYSalvo {
  id            String          @id @default(uuid(7)) @db.Uuid
  terminacionId String          @unique @map("terminacion_id") @db.Uuid
  terminacion   Terminacion     @relation(fields: [terminacionId], references: [id], onDelete: Cascade)
  estado        EstadoPazYSalvo @default(PENDIENTE)
  documentoId   String?         @map("documento_id") @db.Uuid
  creadoEn      DateTime        @default(now()) @map("creado_en")

  items PazYSalvoItem[]

  @@map("paz_y_salvo")
}

model PazYSalvoItem {
  id          String    @id @default(uuid(7)) @db.Uuid
  pazYSalvoId String    @map("paz_y_salvo_id") @db.Uuid
  pazYSalvo   PazYSalvo @relation(fields: [pazYSalvoId], references: [id], onDelete: Cascade)
  area        String // "Activos", "Cartera", "Documentos", "Sistemas"…
  concepto    String
  cumplido    Boolean   @default(false)
  observacion String?
  verificadoPorId String? @map("verificado_por_id") @db.Uuid
  verificadoEn DateTime? @map("verificado_en")

  @@index([pazYSalvoId])
  @@map("paz_y_salvo_item")
}
