// Esquema Prisma — Plataforma de Gestión Humana, Jurídica y SST · KUPOCELL S.A.S.
// Convención: modelos en español PascalCase → tablas snake_case (ver docs/diseno/d1_datamodel.md).
// Excepción: User/Session/Account/Verification los gestiona Better Auth (veredicto C2).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ═══════════════════════════════════════════════════════════════════════════
// AUTENTICACIÓN (Better Auth) — User extendido con campos de la plataforma
// ═══════════════════════════════════════════════════════════════════════════

enum EstadoUsuario {
  ACTIVO
  INACTIVO
  BLOQUEADO

  @@map("estado_usuario")
}

model User {
  id            String   @id @default(uuid(7)) @db.Uuid
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Plugin admin de Better Auth
  role       String?   @default("user")
  banned     Boolean?  @default(false)
  banReason  String?   @map("ban_reason")
  banExpires DateTime? @map("ban_expires")

  // Campos de la plataforma
  rolId                String        @map("rol_id") @db.Uuid
  rol                  Rol           @relation(fields: [rolId], references: [id])
  estado               EstadoUsuario @default(ACTIVO)
  debeCambiarPassword  Boolean       @default(true) @map("debe_cambiar_password")
  telefonoE164         String?       @map("telefono_e164")
  whatsappOptIn        Boolean       @default(false) @map("whatsapp_opt_in")
  whatsappOptInFecha   DateTime?     @map("whatsapp_opt_in_fecha")
  ultimoAcceso         DateTime?     @map("ultimo_acceso")

  sessions    Session[]
  accounts    Account[]
  sedes       UsuarioSede[]
  // Roles adicionales al principal (`rolId`). Los permisos efectivos son la
  // unión de todos; ver fusionarPermisos() en src/lib/permisos/tipos.ts.
  rolesExtra  UsuarioRol[]
  colaborador Colaborador?

  @@map("user")
}

/**
 * Roles adicionales de un usuario. El rol principal sigue en `User.rolId`
 * (es el que se muestra en los listados y define si es admin de Better Auth);
 * esta tabla agrega los demás sombreros que lleve la misma persona, p. ej.
 * quien cubre Jurídica y Talento Humano mientras la empresa crece.
 */
model UsuarioRol {
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  rolId  String @map("rol_id") @db.Uuid
  rol    Rol    @relation(fields: [rolId], references: [id], onDelete: Cascade)

  @@id([userId, rolId])
  @@map("usuario_rol")
}

model Session {
  id        String   @id @default(uuid(7)) @db.Uuid
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  impersonatedBy String? @map("impersonated_by")

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(uuid(7)) @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(uuid(7)) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verification")
}

// ═══════════════════════════════════════════════════════════════════════════
// RBAC — roles con matriz de permisos editable, alcance por permiso (C13)
// ═══════════════════════════════════════════════════════════════════════════

enum AccionPermiso {
  VER
  CREAR
  EDITAR
  ELIMINAR
  APROBAR
  EXPORTAR

  @@map("accion_permiso")
}

enum AlcanceDatos {
  TODAS_SEDES
  SEDES_ASIGNADAS
  EQUIPO
  PROPIO

  @@map("alcance_datos")
}

model Rol {
  id          String       @id @default(uuid(7)) @db.Uuid
  nombre      String       @unique
  descripcion String?
  esSistema   Boolean      @default(false) @map("es_sistema")
  creadoEn    DateTime     @default(now()) @map("creado_en")
  actualizadoEn DateTime   @updatedAt @map("actualizado_en")

  permisos RolPermiso[]
  usuarios User[]
  usuariosExtra UsuarioRol[]
  cargosDefecto Cargo[] @relation("CargoRolDefecto")

  @@map("rol")
}

// `modulo` es String validado contra constantes tipadas (src/lib/permisos/modulos.ts)
// para soportar módulos personalizados con clave `custom:{slug}` (veredicto C13).
model RolPermiso {
  id      String        @id @default(uuid(7)) @db.Uuid
  rolId   String        @map("rol_id") @db.Uuid
  rol     Rol           @relation(fields: [rolId], references: [id], onDelete: Cascade)
  modulo  String
  accion  AccionPermiso
  alcance AlcanceDatos  @default(TODAS_SEDES)

  @@unique([rolId, modulo, accion])
  @@map("rol_permiso")
}

model UsuarioSede {
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  sedeId String @map("sede_id") @db.Uuid
  sede   Sede   @relation(fields: [sedeId], references: [id], onDelete: Cascade)

  @@id([userId, sedeId])
  @@map("usuario_sede")
}

// ═══════════════════════════════════════════════════════════════════════════
// SEDES / CIUDADES — separación transversal exigida por requerimiento 2.7
// ═══════════════════════════════════════════════════════════════════════════

model Ciudad {
  id           String  @id @default(uuid(7)) @db.Uuid
  nombre       String
  departamento String
  codigoDane   String? @map("codigo_dane")
  creadoEn     DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  sedes         Sede[]
  colaboradores Colaborador[]

  @@unique([nombre, departamento])
  @@map("ciudad")
}

model Sede {
  id          String  @id @default(uuid(7)) @db.Uuid
  nombre      String  @unique
  ciudadId    String  @map("ciudad_id") @db.Uuid
  ciudad      Ciudad  @relation(fields: [ciudadId], references: [id])
  direccion   String
  telefono    String?
  esPrincipal Boolean @default(false) @map("es_principal")
  activa      Boolean @default(true)
  creadoEn    DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  usuarios      UsuarioSede[]
  colaboradores Colaborador[]
  contratos     Contrato[]
  contratosOps  ContratoOps[]
  activos       Activo[]
  acuerdosEvaluacion AcuerdoEvaluacion[]

  @@map("sede")
}

// ═══════════════════════════════════════════════════════════════════════════
// EMPRESA — singleton de configuración
// ═══════════════════════════════════════════════════════════════════════════

model ConfiguracionEmpresa {
  id                 String  @id @default(uuid(7)) @db.Uuid
  razonSocial        String  @map("razon_social")
  nombreComercial    String  @map("nombre_comercial")
  nit                String
  representanteLegal String  @map("representante_legal")
  representanteLegalCc String? @map("representante_legal_cc") // C.C. del rep. legal (contratos)
  emailContacto      String? @map("email_contacto")
  telefono           String?
  direccion          String?
  sitioWeb           String? @map("sitio_web")
  logoUrl            String? @map("logo_url")
  /**
   * Papel membretado de los documentos legales (contratos, autorizaciones,
   * acuerdos): imagen de página completa SIN el pie de contacto, porque ese lo
   * escribe la app con los datos de aquí mismo. Así cambiar el correo o el NIT
   * es editar un campo, no rehacer la imagen en Word.
   *
   * Vacío = se usa el membrete que viene con la aplicación.
   */
  membreteFondoPath  String? @map("membrete_fondo_path")
  /**
   * Firma escaneada del representante legal, para estampar en los documentos que
   * la empresa emite ya firmados (hoy, el acuerdo de evaluación previa).
   *
   * Es un activo delicado: quien tenga la imagen puede estamparla donde quiera.
   * Por eso NO se expone por ninguna URL —no hay endpoint que la devuelva— y
   * solo se lee en el servidor al generar el PDF. Se guarda la ruta, no el
   * archivo, igual que el resto de documentos privados.
   */
  firmaRepLegalPath  String? @map("firma_rep_legal_path")
  // Días hábiles: el sábado cuenta como hábil salvo configuración contraria (C6)
  sabadoHabil        Boolean @default(true) @map("sabado_habil")
  // Interruptores de nómina (editables por RRHH sin cambio de código):
  // retención en la fuente (procedimiento 1) y exoneración de aportes Ley 114-1 (art. 65 Ley 1819).
  aplicaRetefuente   Boolean @default(false) @map("aplica_retefuente")
  empresaExonerada   Boolean @default(true) @map("empresa_exonerada")
  actualizadoEn      DateTime @updatedAt @map("actualizado_en")

  @@map("configuracion_empresa")
}

// ═══════════════════════════════════════════════════════════════════════════
// AUDITORÍA — requerimiento general 2.5: quién creó/modificó/eliminó y cuándo
// ═══════════════════════════════════════════════════════════════════════════

enum AccionAuditoria {
  CREAR
  EDITAR
  ELIMINAR
  LOGIN
  LOGOUT
  ACCESO
  EXPORTAR

  @@map("accion_auditoria")
}

model AuditLog {
  id         String          @id @default(uuid(7)) @db.Uuid
  creadoEn   DateTime        @default(now()) @map("creado_en")
  userId     String?         @map("user_id") @db.Uuid
  userEmail  String?         @map("user_email")
  accion     AccionAuditoria
  modelo     String
  registroId String?         @map("registro_id")
  // Diff JSON { campo: { antes, despues } } con campos sensibles redactados
  diff       Json?
  descripcion String?
  ip         String?

  @@index([modelo, registroId])
  @@index([userId])
  @@map("audit_log")
}

// ═══════════════════════════════════════════════════════════════════════════
// CATÁLOGOS — entidades de seguridad social, bancos, estructura organizacional
// ═══════════════════════════════════════════════════════════════════════════

enum TipoEntidadSS {
  EPS
  ARL
  AFP
  FONDO_CESANTIAS
  CAJA_COMPENSACION

  @@map("tipo_entidad_ss")
}

model EntidadSeguridadSocial {
  id     String        @id @default(uuid(7)) @db.Uuid
  tipo   TipoEntidadSS
  nombre String
  codigo String? // código PILA del operador
  activa Boolean       @default(true)

  colaboradoresEps            Colaborador[] @relation("ColEps")
  colaboradoresArl            Colaborador[] @relation("ColArl")
  colaboradoresAfp            Colaborador[] @relation("ColAfp")
  colaboradoresFondoCesantias Colaborador[] @relation("ColFondoCesantias")
  colaboradoresCaja           Colaborador[] @relation("ColCaja")

  @@unique([tipo, nombre])
  @@map("entidad_seguridad_social")
}

model Banco {
  id            String        @id @default(uuid(7)) @db.Uuid
  nombre        String        @unique
  codigoAch     String?       @map("codigo_ach")
  activo        Boolean       @default(true)
  colaboradores Colaborador[]

  @@map("banco")
}

enum ClaseRiesgoArl {
  I
  II
  III
  IV
  V

  @@map("clase_riesgo_arl")
}

model Area {
  id            String       @id @default(uuid(7)) @db.Uuid
  nombre        String       @unique
  padreId       String?      @map("padre_id") @db.Uuid
  padre         Area?        @relation("AreaJerarquia", fields: [padreId], references: [id])
  hijas         Area[]       @relation("AreaJerarquia")
  responsableId String?      @map("responsable_id") @db.Uuid
  responsable   Colaborador? @relation("AreaResponsable", fields: [responsableId], references: [id])
  activa        Boolean      @default(true)
  creadoEn      DateTime     @default(now()) @map("creado_en")
  actualizadoEn DateTime     @updatedAt @map("actualizado_en")

  cargos        Cargo[]
  colaboradores Colaborador[]

  @@map("area")
}

model Cargo {
  id                 String          @id @default(uuid(7)) @db.Uuid
  nombre             String
  areaId             String          @map("area_id") @db.Uuid
  area               Area            @relation(fields: [areaId], references: [id])
  nivel              String? // directivo / coordinación / operativo…
  funciones          String? // alimenta certificación CON_FUNCIONES
  // Funciones para el contrato (cláusula de funciones), en grupos con viñetas.
  // Estructura: [{ grupo: string, items: string[] }]
  funcionesContrato  Json?           @map("funciones_contrato")
  claseRiesgoDefecto ClaseRiesgoArl? @map("clase_riesgo_defecto")
  rolDefectoId       String?         @map("rol_defecto_id") @db.Uuid // rol que se asigna al crear el usuario del colaborador
  rolDefecto         Rol?            @relation("CargoRolDefecto", fields: [rolDefectoId], references: [id])
  activo             Boolean         @default(true)
  creadoEn           DateTime        @default(now()) @map("creado_en")
  actualizadoEn      DateTime        @updatedAt @map("actualizado_en")

  colaboradores Colaborador[]
  contratos     Contrato[]
  contratosOps  ContratoOps[]
  acuerdosEvaluacion AcuerdoEvaluacion[]

  @@unique([nombre, areaId])
  @@map("cargo")
}

// Plantilla de contrato por modalidad (editable por la encargada). El texto legal
// vive aquí (cláusulas con {{variables}}); las funciones salen del cargo.
model PlantillaContrato {
  id            String              @id @default(uuid(7)) @db.Uuid
  nombre        String
  tipo          String // 'OPS' (prestación de servicios); luego laborales
  titulo        String // "CONTRATO DE PRESTACIÓN DE SERVICIOS"
  intro         String // párrafo introductorio (con {{variables}})
  cierre        String              @default("") // párrafo final "Leído, entendido y aprobado" antes de las firmas
  activa        Boolean             @default(true)
  creadoEn      DateTime            @default(now()) @map("creado_en")
  actualizadoEn DateTime            @updatedAt @map("actualizado_en")

  clausulas ClausulaPlantilla[]

  @@map("plantilla_contrato")
}

model ClausulaPlantilla {
  id          String            @id @default(uuid(7)) @db.Uuid
  plantillaId String            @map("plantilla_id") @db.Uuid
  plantilla   PlantillaContrato @relation(fields: [plantillaId], references: [id], onDelete: Cascade)
  orden       Int
  titulo      String // "PRIMERA. – OBJETO:"
  cuerpo      String // texto con {{variables}}; líneas que empiezan con "- " son viñetas
  esFunciones Boolean           @default(false) @map("es_funciones") // aquí se insertan las funciones del cargo

  @@index([plantillaId])
  @@map("clausula_plantilla")
}

// ═══════════════════════════════════════════════════════════════════════════
// COLABORADORES — ficha completa (requerimiento 3.1)
// ═══════════════════════════════════════════════════════════════════════════

enum TipoDocumentoIdentidad {
  CC
  CE
  TI
  PASAPORTE
  PPT
  NIT

  @@map("tipo_documento_identidad")
}

enum Genero {
  MASCULINO
  FEMENINO
  OTRO
  PREFIERE_NO_DECIR

  @@map("genero")
}

enum EstadoCivil {
  SOLTERO
  CASADO
  UNION_LIBRE
  SEPARADO
  DIVORCIADO
  VIUDO

  @@map("estado_civil")
}

enum GrupoSanguineo {
  A_POS
  A_NEG
  B_POS
  B_NEG
  AB_POS
  AB_NEG
  O_POS
  O_NEG

  @@map("grupo_sanguineo")
}

enum NivelEducativo {
  PRIMARIA
  BACHILLER
  TECNICO
  TECNOLOGO
  PREGRADO
  ESPECIALIZACION
  MAESTRIA
  DOCTORADO

  @@map("nivel_educativo")
}

enum TipoCuentaBancaria {
  AHORROS
  CORRIENTE
  BILLETERA_DIGITAL

  @@map("tipo_cuenta_bancaria")
}

enum TipoVinculo {
  TERMINO_INDEFINIDO
  TERMINO_FIJO
  OBRA_LABOR
  APRENDIZ_SENA
  OPS
  PRACTICANTE

  @@map("tipo_vinculo")
}

// Modalidades que usa la empresa. El teletrabajo (Ley 1221/2008) es una figura
// distinta del trabajo remoto (Ley 2121/2021) y exige obligaciones propias
// (dotación de equipos, reporte del puesto a la ARL); KUPOCELL no la aplica,
// así que no se ofrece para no registrar contratos con una figura que no se cumple.
enum ModalidadTrabajo {
  PRESENCIAL
  REMOTO
  HIBRIDO

  @@map("modalidad_trabajo")
}

enum EstadoColaborador {
  ACTIVO
  INACTIVO
  RETIRADO

  @@map("estado_colaborador")
}

model Colaborador {
  id                 String                 @id @default(uuid(7)) @db.Uuid
  // Identificación
  tipoDocumento      TipoDocumentoIdentidad @map("tipo_documento")
  numeroDocumento    String                 @map("numero_documento")
  fechaExpedicionDoc DateTime?              @map("fecha_expedicion_doc") @db.Date
  lugarExpedicionDoc String?                @map("lugar_expedicion_doc")
  nombres            String
  apellidos          String
  fechaNacimiento    DateTime?              @map("fecha_nacimiento") @db.Date
  lugarNacimiento    String?                @map("lugar_nacimiento")
  genero             Genero?
  estadoCivil        EstadoCivil?           @map("estado_civil")
  grupoSanguineo     GrupoSanguineo?        @map("grupo_sanguineo")
  fotoPath           String?                @map("foto_path")
  // Contacto
  direccion          String?
  barrio             String?
  ciudadResidenciaId String?                @map("ciudad_residencia_id") @db.Uuid
  ciudadResidencia   Ciudad?                @relation(fields: [ciudadResidenciaId], references: [id])
  celular            String
  telefono           String?
  emailPersonal      String?                @map("email_personal")
  emailCorporativo   String?                @map("email_corporativo")
  // Contacto de emergencia
  emergenciaNombre     String? @map("emergencia_nombre")
  emergenciaParentesco String? @map("emergencia_parentesco")
  emergenciaTelefono   String? @map("emergencia_telefono")
  // Educación
  nivelEducativoMax NivelEducativo?        @map("nivel_educativo_max")
  educacion         EducacionColaborador[]
  // Salud / seguridad social (datos sensibles: módulo colaboradores_salud)
  epsId              String?         @map("eps_id") @db.Uuid
  eps                EntidadSeguridadSocial? @relation("ColEps", fields: [epsId], references: [id])
  afpId              String?         @map("afp_id") @db.Uuid
  afp                EntidadSeguridadSocial? @relation("ColAfp", fields: [afpId], references: [id])
  fondoCesantiasId   String?         @map("fondo_cesantias_id") @db.Uuid
  fondoCesantias     EntidadSeguridadSocial? @relation("ColFondoCesantias", fields: [fondoCesantiasId], references: [id])
  cajaCompensacionId String?         @map("caja_compensacion_id") @db.Uuid
  cajaCompensacion   EntidadSeguridadSocial? @relation("ColCaja", fields: [cajaCompensacionId], references: [id])
  arlId              String?         @map("arl_id") @db.Uuid
  arl                EntidadSeguridadSocial? @relation("ColArl", fields: [arlId], references: [id])
  claseRiesgoArl     ClaseRiesgoArl? @map("clase_riesgo_arl")
  // Datos bancarios
  bancoId      String?             @map("banco_id") @db.Uuid
  banco        Banco?              @relation(fields: [bancoId], references: [id])
  tipoCuenta   TipoCuentaBancaria? @map("tipo_cuenta")
  numeroCuenta String?             @map("numero_cuenta")
  // Organizacional
  tipoVinculo      TipoVinculo      @map("tipo_vinculo")
  sedeId           String           @map("sede_id") @db.Uuid
  sede             Sede             @relation(fields: [sedeId], references: [id])
  areaId           String?          @map("area_id") @db.Uuid
  area             Area?            @relation(fields: [areaId], references: [id])
  cargoId          String?          @map("cargo_id") @db.Uuid
  cargo            Cargo?           @relation(fields: [cargoId], references: [id])
  jefeInmediatoId  String?          @map("jefe_inmediato_id") @db.Uuid
  jefeInmediato    Colaborador?     @relation("JefeInmediato", fields: [jefeInmediatoId], references: [id])
  subordinados     Colaborador[]    @relation("JefeInmediato")
  // Máxima autoridad de la empresa: sus solicitudes se auto-registran (no requieren
  // aprobación superior) y nadie más puede "aprobar" por encima de él.
  esRepresentanteLegal Boolean      @default(false) @map("es_representante_legal")
  modalidadTrabajo ModalidadTrabajo @default(PRESENCIAL) @map("modalidad_trabajo")
  fechaIngreso     DateTime         @map("fecha_ingreso") @db.Date
  fechaRetiro      DateTime?        @map("fecha_retiro") @db.Date
  estado           EstadoColaborador @default(ACTIVO)
  // Dotación
  tallaCamisa   String? @map("talla_camisa")
  tallaPantalon String? @map("talla_pantalon")
  tallaCalzado  String? @map("talla_calzado")
  // Acceso
  usuarioId String? @unique @map("usuario_id") @db.Uuid
  usuario   User?   @relation(fields: [usuarioId], references: [id])

  // Búsqueda insensible a tildes/mayúsculas (nombres + apellidos + documento)
  busquedaNormalizada String @default("") @map("busqueda_normalizada")

  areasResponsable      Area[]                 @relation("AreaResponsable")
  contratos             Contrato[]
  contratosOps          ContratoOps[]
  opsSupervisados       ContratoOps[]          @relation("SupervisorOps")
  cuentasCobro          CuentaCobroOps[]
  variacionesSalariales VariacionSalarial[]
  incapacidades         Incapacidad[]
  licencias             Licencia[]
  permisos              Permiso[]
  vacaciones            Vacaciones[]
  novedadesConcepto     NovedadConcepto[]
  bonificaciones        Bonificacion[]
  solicitudes           Solicitud[]
  certificaciones       CertificacionLaboral[]
  liquidaciones         LiquidacionNomina[]
  novedadesHoras        NovedadHoras[]
  comisiones            Comision[]
  prestamos             Prestamo[]
  terminaciones         Terminacion[]
  asignacionesActivo    AsignacionActivo[]
  entregasDotacion      EntregaDotacion[]
  asistencias           AsistenciaCapacitacion[]
  evaluaciones          EvaluacionDesempeno[]
