// ═══════════════════════════════════════════════════════════════════════════
// CONTRATISTAS OPS (prestación de servicios) — flujo separado de nómina (3.2)
// ═══════════════════════════════════════════════════════════════════════════

enum EstadoContratoOps {
  BORRADOR
  ACTIVO
  FIRMADO
  TERMINADO

  @@map("estado_contrato_ops")
}

enum EstadoAcuerdoEvaluacion {
  EN_EVALUACION
  APROBADO
  NO_APROBADO

  @@map("estado_acuerdo_evaluacion")
}

/**
 * Acuerdo de evaluación previa SIN relación laboral: la empresa evalúa a un
 * ASPIRANTE antes de decidir si lo contrata.
 *
 * Deliberadamente NO es un Colaborador ni un Contrato. El acuerdo declara que no
 * hay contrato de trabajo ni precontrato, y registrar a esa persona en la base de
 * empleados diría lo contrario: ante una inspección o una demanda por contrato
 * realidad, el propio sistema contradiría el documento firmado. Además arrastraría
 * afiliaciones, expediente, nómina y vacaciones que no le corresponden, y falsearía
 * el headcount.
 *
 * Si la evaluación se aprueba, `colaboradorId` guarda la ficha que se creó a partir
 * de este acuerdo (ver convertirEnColaborador): ahí sí nace la relación contractual.
 */
model AcuerdoEvaluacion {
  id     String @id @default(uuid(7)) @db.Uuid
  numero String @unique

  // Aspirante — datos mínimos que exige el documento (no hay ficha que consultar).
  nombres            String
  apellidos          String
  tipoDocumento      TipoDocumentoIdentidad @default(CC) @map("tipo_documento")
  numeroDocumento    String                 @map("numero_documento")
  lugarExpedicionDoc String?                @map("lugar_expedicion_doc")
  direccion          String?
  email              String
  celular            String?

  // Qué se evalúa y dónde
  cargoEvaluado String  @map("cargo_evaluado")
  cargoId       String? @map("cargo_id") @db.Uuid
  cargo         Cargo?  @relation(fields: [cargoId], references: [id])
  sedeId        String? @map("sede_id") @db.Uuid
  sede          Sede?   @relation(fields: [sedeId], references: [id])

  // Vigencia de la evaluación (sin prórroga tácita, cláusula tercera)
  fechaInicio DateTime @map("fecha_inicio") @db.Date
  fechaFin    DateTime @map("fecha_fin") @db.Date

  ciudadFirma            String? @map("ciudad_firma")
  aniosConfidencialidad  Int     @default(2) @map("anios_confidencialidad")

  estado        EstadoAcuerdoEvaluacion @default(EN_EVALUACION)
  observaciones String?
  // Se envió al aspirante para firma (se guarda para saber si ya salió el correo).
  enviadoEn     DateTime?               @map("enviado_en")
  // Quién envió el enlace: el aspirante no tiene cuenta, así que el documento que
  // sube se atribuye a esta persona (Documento.subidoPorId es obligatorio). El
  // nombre del archivo y la auditoría dejan claro que lo aportó el aspirante.
  enviadoPorId  String?                 @map("enviado_por_id") @db.Uuid

  /**
   * Enlace público de un solo propósito para que el ASPIRANTE suba el acuerdo
   * firmado sin tener cuenta en el sistema. Es un secreto portador: quien tenga
   * el token puede subir un PDF a ESTE acuerdo y nada más — no lee ni modifica
   * otros datos. Caduca para que un enlace viejo no quede abierto para siempre.
   */
  tokenSubida   String?   @unique @map("token_subida")
  tokenExpiraEn DateTime? @map("token_expira_en")
  firmadoEn     DateTime? @map("firmado_en")

  decididoEn    DateTime?               @map("decidido_en")

  // Ficha creada al aprobar; null mientras no se convierta.
  colaboradorId String?      @unique @map("colaborador_id") @db.Uuid
  colaborador   Colaborador? @relation("ColaboradorDesdeEvaluacion", fields: [colaboradorId], references: [id])

  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  @@index([estado])
  @@map("acuerdo_evaluacion")
}

model ContratoOps {
  id            String            @id @default(uuid(7)) @db.Uuid
  numero        String            @unique
  colaboradorId String            @map("colaborador_id") @db.Uuid
  colaborador   Colaborador       @relation(fields: [colaboradorId], references: [id])
  objeto        String
  valorTotal    Decimal           @map("valor_total") @db.Decimal(14, 2)
  valorMensual  Decimal?          @map("valor_mensual") @db.Decimal(14, 2)
  supervisorId  String?           @map("supervisor_id") @db.Uuid
  supervisor    Colaborador?      @relation("SupervisorOps", fields: [supervisorId], references: [id])
  cargoId       String?           @map("cargo_id") @db.Uuid
  cargo         Cargo?            @relation(fields: [cargoId], references: [id])
  sedeId        String            @map("sede_id") @db.Uuid
  sede          Sede              @relation(fields: [sedeId], references: [id])
  fechaInicio   DateTime          @map("fecha_inicio") @db.Date
  fechaFin      DateTime          @map("fecha_fin") @db.Date
  rut           String?
  estado        EstadoContratoOps @default(ACTIVO)
  // Snapshot de los datos resueltos del PDF (empresa, plantilla, encabezado, nombres)
  // para poder regenerar el documento firmado sin re-derivar el formulario.
  contenidoPdf  Json?             @map("contenido_pdf")
  // Origen del PDF: GENERADO (desde plantilla in-app) o SUBIDO (contrato ya existente,
  // normalmente firmado en físico; se adjunta como Documento y se omite la firma digital).
  origenPdf     OrigenPdfContrato @default(GENERADO) @map("origen_pdf")
  // Firma digital de cada parte (imagen PNG en storage) + fecha y usuario que la aplicó.
  firmaContratistaPath  String?   @map("firma_contratista_path")
  firmaContratistaFecha DateTime? @map("firma_contratista_fecha")
  firmaContratistaPorId String?   @map("firma_contratista_por_id") @db.Uuid
  firmaContratantePath  String?   @map("firma_contratante_path")
  firmaContratanteFecha DateTime? @map("firma_contratante_fecha")
  firmaContratantePorId String?   @map("firma_contratante_por_id") @db.Uuid
  creadoEn      DateTime          @default(now()) @map("creado_en")
  actualizadoEn DateTime          @updatedAt @map("actualizado_en")

  entregables   EntregableOps[]
  cuentasCobro  CuentaCobroOps[]
  evidenciasFirma EvidenciaFirmaContrato[]

  @@index([colaboradorId, estado])
  @@index([sedeId])
  @@map("contrato_ops")
}

enum OrigenPdfContrato {
  GENERADO
  SUBIDO
}

enum RolFirmaContrato {
  CONTRATISTA
  CONTRATANTE
  EMPLEADO
  EMPLEADOR

  @@map("rol_firma_contrato")
}

// Rastro probatorio de cada acto de firma (Ley 527 de 1999): quién, cuándo, desde
// dónde y con qué huella de documento. Se registra en BD, no dentro del PDF.
model EvidenciaFirmaContrato {
  id            String           @id @default(uuid(7)) @db.Uuid
  // Exactamente uno de los dos: contrato OPS o contrato laboral.
  contratoOpsId String?          @map("contrato_ops_id") @db.Uuid
  contratoOps   ContratoOps?     @relation(fields: [contratoOpsId], references: [id], onDelete: Cascade)
  contratoId    String?          @map("contrato_id") @db.Uuid
  contrato      Contrato?        @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  rol           RolFirmaContrato
  userId        String?          @map("user_id") @db.Uuid
  userEmail     String?          @map("user_email")
  ip            String?
  userAgent     String?          @map("user_agent")
  metodoAuth    String           @default("SESION") @map("metodo_auth") // método con que se autenticó el firmante
  // Documentos resultantes con su huella: [{ tipo, documentoId, sha256 }]
  documentos    Json?
  firmadoEn     DateTime         @default(now()) @map("firmado_en")

  @@index([contratoOpsId])
  @@map("evidencia_firma_contrato")
}

// Propósito de un código de verificación de firma (a qué firma autoriza).
enum PropositoCodigoFirma {
  FIRMA_CONTRATO_OPS
  FIRMA_CONTRATO_LABORAL

  @@map("proposito_codigo_firma")
}

// Código de un solo uso (OTP) enviado por correo para autorizar una firma
// electrónica en autoservicio. Deja huella del consentimiento previo (Ley 527):
// se guarda el hash del código (nunca en texto plano), a quién y para qué se
// emitió, vencimiento, intentos e IP. El código válido más reciente por
// (usuario, propósito, referencia) es el vigente.
model CodigoFirma {
  id           String               @id @default(uuid(7)) @db.Uuid
  proposito    PropositoCodigoFirma
  referenciaId String               @map("referencia_id") @db.Uuid // p. ej. contratoOpsId
  userId       String               @map("user_id") @db.Uuid
  email        String // correo destino al que se envió el código
  codigoHash   String               @map("codigo_hash") // SHA-256 del código de 6 dígitos
  expiraEn     DateTime             @map("expira_en")
  intentos     Int                  @default(0) // intentos fallidos de validación
  usadoEn      DateTime?            @map("usado_en") // cuándo se consumió al firmar
  ip           String?
  creadoEn     DateTime             @default(now()) @map("creado_en")

  @@index([userId, proposito, referenciaId])
  @@map("codigo_firma")
}

model EntregableOps {
  id           String      @id @default(uuid(7)) @db.Uuid
  contratoOpsId String     @map("contrato_ops_id") @db.Uuid
  contratoOps  ContratoOps @relation(fields: [contratoOpsId], references: [id], onDelete: Cascade)
  descripcion  String
  fechaEntrega DateTime?   @map("fecha_entrega") @db.Date
  cumplido     Boolean     @default(false)

  @@index([contratoOpsId])
  @@map("entregable_ops")
}

enum EstadoCuentaCobro {
