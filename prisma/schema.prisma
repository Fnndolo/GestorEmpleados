  vigenciaDesde DateTime  @map("vigencia_desde") @db.Date
  vigenciaHasta DateTime? @map("vigencia_hasta") @db.Date
  fuenteLegal   String    @map("fuente_legal")
  descripcion   String?

  @@index([clave, vigenciaDesde])
  @@map("parametro_legal")
}

enum TipoConcepto {
  DEVENGADO
  DEDUCCION
  PROVISION
  APORTE_PATRONAL

  @@map("tipo_concepto")
}

enum TipoCalculoConcepto {
  VALOR_FIJO
  PORCENTAJE_BASE
  CANTIDAD_POR_VALOR
  SISTEMA // calculado por el motor en código

  @@map("tipo_calculo_concepto")
}

model ConceptoNomina {
  id                  String              @id @default(uuid(7)) @db.Uuid
  codigo              String              @unique
  nombre              String
  tipo                TipoConcepto
  tipoCalculo         TipoCalculoConcepto @default(SISTEMA) @map("tipo_calculo")
  constitutivoSalario Boolean             @default(false) @map("constitutivo_salario")
  afectaIbcSs         Boolean             @default(false) @map("afecta_ibc_ss")
  basePrestaciones    Boolean             @default(false) @map("base_prestaciones")
  baseVacaciones      Boolean             @default(false) @map("base_vacaciones")
  afectaRetefuente    Boolean             @default(false) @map("afecta_retefuente")
  porcentaje          Decimal?            @db.Decimal(8, 4) // para PORCENTAJE_BASE
  valorFijo           Decimal?            @map("valor_fijo") @db.Decimal(14, 2)
  cuentaContable      String?             @map("cuenta_contable")
  esSistema           Boolean             @default(false) @map("es_sistema")
  activo              Boolean             @default(true)
  orden               Int                 @default(100)

  novedades NovedadConcepto[]

  @@map("concepto_nomina")
}

// Tipos de hora extra/recargo con factor (Ley 2466). El factor vigente se siembra
// según la fecha; el clasificador deriva el tipo desde rangos horarios.
model TipoHora {
  id        String   @id @default(uuid(7)) @db.Uuid
  codigo    String // HED, HEN, RN, RD, RND, HEDD, HEND
  nombre    String
  factor    Decimal  @db.Decimal(6, 4) // 1.25 HED, 1.75 HEN, 0.35 RN, 0.80 RD…
  vigenteDesde DateTime @map("vigente_desde") @db.Date
  vigenteHasta DateTime? @map("vigente_hasta") @db.Date

  @@index([codigo, vigenteDesde])
  @@map("tipo_hora")
}

enum TipoPeriodoNomina {
  MENSUAL
  QUINCENAL

  @@map("tipo_periodo_nomina")
}

enum EstadoPeriodoNomina {
  BORRADOR
  CALCULADA
  APROBADA
  CERRADA
  PAGADA

  @@map("estado_periodo_nomina")
}

model PeriodoNomina {
  id                 String              @id @default(uuid(7)) @db.Uuid
  nombre             String // "Junio 2026", "Junio 2026 - 1ra quincena"
  tipo               TipoPeriodoNomina   @default(MENSUAL)
  anio               Int
  mes                Int
  quincena           Int? // 1 o 2 si quincenal
  fechaInicio        DateTime            @map("fecha_inicio") @db.Date
  fechaFin           DateTime            @map("fecha_fin") @db.Date
  diasPeriodo        Int                 @map("dias_periodo") // 15 o 30
  estado             EstadoPeriodoNomina @default(BORRADOR)
  parametrosSnapshot Json?               @map("parametros_snapshot")
  esAjuste           Boolean             @default(false) @map("es_ajuste")
  creadoEn           DateTime            @default(now()) @map("creado_en")
  actualizadoEn      DateTime            @updatedAt @map("actualizado_en")

  liquidaciones LiquidacionNomina[]
  comisiones    Comision[]
  novedadesHoras NovedadHoras[]
  bonificaciones Bonificacion[]
  novedadesConcepto NovedadConcepto[]

  @@map("periodo_nomina")
}

// Aplicación de un concepto configurable del catálogo a un colaborador en un
// periodo (auxilio de alimentación, prima extralegal, descuento…). El motor lo
// liquida según las banderas del concepto (constitutivo, IBC, prestaciones).
model NovedadConcepto {
  id            String         @id @default(uuid(7)) @db.Uuid
  colaboradorId String         @map("colaborador_id") @db.Uuid
  colaborador   Colaborador    @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  periodoId     String         @map("periodo_id") @db.Uuid
  periodo       PeriodoNomina  @relation(fields: [periodoId], references: [id], onDelete: Cascade)
  conceptoId    String         @map("concepto_id") @db.Uuid
  concepto      ConceptoNomina @relation(fields: [conceptoId], references: [id])
  valor         Decimal        @db.Decimal(14, 2)
  observaciones String?
  creadoEn      DateTime       @default(now()) @map("creado_en")

  @@index([colaboradorId, periodoId])
  @@index([periodoId])
  @@map("novedad_concepto")
}

model LiquidacionNomina {
  id              String        @id @default(uuid(7)) @db.Uuid
  periodoId       String        @map("periodo_id") @db.Uuid
  periodo         PeriodoNomina @relation(fields: [periodoId], references: [id], onDelete: Cascade)
  colaboradorId   String        @map("colaborador_id") @db.Uuid
  colaborador     Colaborador   @relation(fields: [colaboradorId], references: [id])
  diasTrabajados  Decimal       @map("dias_trabajados") @db.Decimal(5, 2)
  salarioBase     Decimal       @map("salario_base") @db.Decimal(14, 2)
  ibc             Decimal       @db.Decimal(14, 2)
  totalDevengado  Decimal       @map("total_devengado") @db.Decimal(14, 2)
  totalDeducido   Decimal       @map("total_deducido") @db.Decimal(14, 2)
  neto            Decimal       @db.Decimal(14, 2)
  documentoId     String?       @map("documento_id") @db.Uuid // desprendible PDF
  creadoEn        DateTime      @default(now()) @map("creado_en")

  detalles DetalleNomina[]

  @@unique([periodoId, colaboradorId])
  @@index([colaboradorId])
  @@map("liquidacion_nomina")
}

model DetalleNomina {
  id             String            @id @default(uuid(7)) @db.Uuid
  liquidacionId  String            @map("liquidacion_id") @db.Uuid
  liquidacion    LiquidacionNomina @relation(fields: [liquidacionId], references: [id], onDelete: Cascade)
  conceptoCodigo String            @map("concepto_codigo")
  conceptoNombre String            @map("concepto_nombre")
  tipo           TipoConcepto
  cantidad       Decimal?          @db.Decimal(8, 2)
  base           Decimal?          @db.Decimal(14, 2)
  factor         Decimal?          @db.Decimal(8, 4)
  valor          Decimal           @db.Decimal(14, 2)
  cuentaContable String?           @map("cuenta_contable")

  @@index([liquidacionId])
  @@map("detalle_nomina")
}

model NovedadHoras {
  id            String        @id @default(uuid(7)) @db.Uuid
  colaboradorId String        @map("colaborador_id") @db.Uuid
  colaborador   Colaborador   @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  periodoId     String?       @map("periodo_id") @db.Uuid
  periodo       PeriodoNomina? @relation(fields: [periodoId], references: [id])
  fecha         DateTime      @db.Date
  horaInicio    String        @map("hora_inicio") // "19:00"
  horaFin       String        @map("hora_fin") // "22:00"
  tipoHora      String        @map("tipo_hora") // HED/HEN/RN/RD/RND clasificado
  horas         Decimal       @db.Decimal(5, 2)
  observaciones String?
  // Id del tramo en el sistema de asistencia externo (ArriveControl). NULL en las
  // novedades cargadas a mano desde la app. Garantiza la idempotencia del lote:
  // reenviar el mismo tramo no vuelve a pagar las horas (contrato §4.1).
  // El par con tipoHora es necesario porque un tramo que cruza las 7:00 p.m. se
  // parte en dos filas (HED + HEN) que comparten la misma referencia.
  referenciaExterna String?    @map("referencia_externa")
  creadoEn      DateTime      @default(now()) @map("creado_en")

  @@unique([referenciaExterna, tipoHora])
  @@index([colaboradorId, periodoId])
  @@map("novedad_horas")
}

enum TipoComision {
  VENTA
  RECAUDO

  @@map("tipo_comision")
}

model Comision {
  id            String        @id @default(uuid(7)) @db.Uuid
  colaboradorId String        @map("colaborador_id") @db.Uuid
  colaborador   Colaborador   @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  periodoId     String?       @map("periodo_id") @db.Uuid
  periodo       PeriodoNomina? @relation(fields: [periodoId], references: [id])
  tipo          TipoComision
  baseCalculo   Decimal       @map("base_calculo") @db.Decimal(14, 2)
  valor         Decimal       @db.Decimal(14, 2)
  descripcion   String?
  creadoEn      DateTime      @default(now()) @map("creado_en")

  @@index([colaboradorId, periodoId])
  @@map("comision")
}

enum EstadoPrestamo {
  ACTIVO
  PAGADO
  CANCELADO

  @@map("estado_prestamo")
}

model Prestamo {
  id            String         @id @default(uuid(7)) @db.Uuid
  colaboradorId String         @map("colaborador_id") @db.Uuid
  colaborador   Colaborador    @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  valorTotal    Decimal        @map("valor_total") @db.Decimal(14, 2)
  numeroCuotas  Int            @map("numero_cuotas")
  valorCuota    Decimal        @map("valor_cuota") @db.Decimal(14, 2)
  saldo         Decimal        @db.Decimal(14, 2)
  fechaInicio   DateTime       @map("fecha_inicio") @db.Date
  estado        EstadoPrestamo @default(ACTIVO)
  descripcion   String?
  creadoEn      DateTime       @default(now()) @map("creado_en")

  cuotas CuotaPrestamo[]

  @@index([colaboradorId, estado])
  @@map("prestamo")
}

model CuotaPrestamo {
  id            String    @id @default(uuid(7)) @db.Uuid
  prestamoId    String    @map("prestamo_id") @db.Uuid
  prestamo      Prestamo  @relation(fields: [prestamoId], references: [id], onDelete: Cascade)
  numero        Int
  valor         Decimal   @db.Decimal(14, 2)
  pagada        Boolean   @default(false)
  periodoId     String?   @map("periodo_id") @db.Uuid
  fechaPago     DateTime? @map("fecha_pago") @db.Date

  @@index([prestamoId])
  @@map("cuota_prestamo")
}

// Planilla PILA mensual (registro del pago y su vencimiento)
model PlanillaPila {
  id           String    @id @default(uuid(7)) @db.Uuid
  periodo      String    @unique // "2026-06"
  fechaLimite  DateTime  @map("fecha_limite") @db.Date
  fechaPago    DateTime? @map("fecha_pago") @db.Date
  valorTotal   Decimal?  @map("valor_total") @db.Decimal(14, 2)
  pagada       Boolean   @default(false)
  documentoId  String?   @map("documento_id") @db.Uuid
  creadoEn     DateTime  @default(now()) @map("creado_en")

  @@map("planilla_pila")
}

// ═══════════════════════════════════════════════════════════════════════════
// TERMINACIONES, LIQUIDACIÓN DEFINITIVA Y PAZ Y SALVO (requerimiento 6.2/6.6)
// ═══════════════════════════════════════════════════════════════════════════

enum TipoTerminacion {
  RENUNCIA_VOLUNTARIA
  SIN_JUSTA_CAUSA
  CON_JUSTA_CAUSA
  TERMINACION_ANTICIPADA
  MUTUO_ACUERDO
  VENCIMIENTO_PLAZO
  PERIODO_PRUEBA
  FIN_OPS

  @@map("tipo_terminacion")
}

enum EstadoTerminacion {
  EN_PROCESO
  LIQUIDADA
  CERRADA

  @@map("estado_terminacion")
}

model Terminacion {
  id            String            @id @default(uuid(7)) @db.Uuid
  colaboradorId String            @map("colaborador_id") @db.Uuid
  colaborador   Colaborador       @relation(fields: [colaboradorId], references: [id])
  tipo          TipoTerminacion
  fechaRetiro   DateTime          @map("fecha_retiro") @db.Date
  preavisoDias  Int?              @map("preaviso_dias")
  // Justa causa: proceso disciplinario cerrado que la sustenta (debido proceso).
  procesoDisciplinarioId String?  @map("proceso_disciplinario_id") @db.Uuid
  procesoDisciplinario   ProcesoDisciplinario? @relation(fields: [procesoDisciplinarioId], references: [id])
  indemnizacion Decimal?          @db.Decimal(14, 2)
  motivo        String?
  estado        EstadoTerminacion @default(EN_PROCESO)
  creadoEn      DateTime          @default(now()) @map("creado_en")
  actualizadoEn DateTime          @updatedAt @map("actualizado_en")

  liquidacion LiquidacionDefinitiva?
  pazYSalvo   PazYSalvo?

  @@index([colaboradorId])
  @@map("terminacion")
}

model LiquidacionDefinitiva {
  id              String      @id @default(uuid(7)) @db.Uuid
  terminacionId   String      @unique @map("terminacion_id") @db.Uuid
  terminacion     Terminacion @relation(fields: [terminacionId], references: [id], onDelete: Cascade)
  diasLiquidados  Int         @map("dias_liquidados")
  salarioBase     Decimal     @map("salario_base") @db.Decimal(14, 2)
  cesantias       Decimal     @db.Decimal(14, 2)
  interesesCesantias Decimal  @map("intereses_cesantias") @db.Decimal(14, 2)
  prima           Decimal     @db.Decimal(14, 2)
  vacaciones      Decimal     @db.Decimal(14, 2)
  indemnizacion   Decimal     @db.Decimal(14, 2)
  otros           Decimal     @default(0) @db.Decimal(14, 2)
  deducciones     Decimal     @default(0) @db.Decimal(14, 2)
  total           Decimal     @db.Decimal(14, 2)
  detalle         Json?
  documentoId     String?     @map("documento_id") @db.Uuid
  creadoEn        DateTime    @default(now()) @map("creado_en")

  @@map("liquidacion_definitiva")
}

enum EstadoPazYSalvo {
  PENDIENTE
  COMPLETO

  @@map("estado_paz_y_salvo")
}

model PazYSalvo {
  id            String          @id @default(uuid(7)) @db.Uuid
  terminacionId String          @unique @map("terminacion_id") @db.Uuid
  terminacion   Terminacion     @relation(fields: [terminacionId], references: [id], onDelete: Cascade)
  estado        EstadoPazYSalvo @default(PENDIENTE)
  documentoId   String?         @map("documento_id") @db.Uuid
  creadoEn      DateTime        @default(now()) @map("creado_en")

  items PazYSalvoItem[]

  @@map("paz_y_salvo")
}

model PazYSalvoItem {
  id          String    @id @default(uuid(7)) @db.Uuid
  pazYSalvoId String    @map("paz_y_salvo_id") @db.Uuid
  pazYSalvo   PazYSalvo @relation(fields: [pazYSalvoId], references: [id], onDelete: Cascade)
  area        String // "Activos", "Cartera", "Documentos", "Sistemas"…
  concepto    String
  cumplido    Boolean   @default(false)
  observacion String?
  verificadoPorId String? @map("verificado_por_id") @db.Uuid
  verificadoEn DateTime? @map("verificado_en")

  @@index([pazYSalvoId])
  @@map("paz_y_salvo_item")
}

// ═══════════════════════════════════════════════════════════════════════════
// ACTIVOS, DOTACIÓN, CAPACITACIONES Y EVALUACIONES (requerimiento 3.6)
// ═══════════════════════════════════════════════════════════════════════════

enum EstadoActivo {
  DISPONIBLE
  ASIGNADO
  EN_MANTENIMIENTO
  DADO_DE_BAJA

  @@map("estado_activo")
}

model Activo {
  id            String       @id @default(uuid(7)) @db.Uuid
  codigo        String       @unique
  nombre        String
  tipo          String // Celular, Computador, Escritorio, Silla ergonómica…
  marca         String?
  serie         String?
  valor         Decimal?     @db.Decimal(14, 2)
  sedeId        String?      @map("sede_id") @db.Uuid
  sede          Sede?        @relation(fields: [sedeId], references: [id])
  estado        EstadoActivo @default(DISPONIBLE)
  observaciones String?
  creadoEn      DateTime     @default(now()) @map("creado_en")

  asignaciones AsignacionActivo[]

  @@index([estado])
  @@map("activo")
}

model AsignacionActivo {
  id                 String      @id @default(uuid(7)) @db.Uuid
  activoId           String      @map("activo_id") @db.Uuid
  activo             Activo      @relation(fields: [activoId], references: [id])
  colaboradorId      String      @map("colaborador_id") @db.Uuid
  colaborador        Colaborador @relation(fields: [colaboradorId], references: [id])
  fechaEntrega       DateTime    @map("fecha_entrega") @db.Date
  fechaDevolucion    DateTime?   @map("fecha_devolucion") @db.Date
  // Entregas hechas en un mismo acto comparten loteId y, por tanto, UNA sola acta
  // (actaEntregaDocId apunta al mismo Documento en todas las filas del lote).
  loteId             String?     @map("lote_id") @db.Uuid
  actaEntregaDocId   String?     @map("acta_entrega_doc_id") @db.Uuid
  actaDevolucionDocId String?    @map("acta_devolucion_doc_id") @db.Uuid
  // Firma digital del colaborador sobre el acta de entrega (desde su autoservicio)
  firmaEntregaEn     DateTime?   @map("firma_entrega_en")
  observaciones      String?
  creadoEn           DateTime    @default(now()) @map("creado_en")

  @@index([colaboradorId])
  @@index([activoId])
  @@index([loteId])
  @@map("asignacion_activo")
}

model EntregaDotacion {
  id            String      @id @default(uuid(7)) @db.Uuid
  colaboradorId String      @map("colaborador_id") @db.Uuid
  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  anio          Int
  corte         String // "Abril", "Agosto", "Diciembre" (3 entregas/año)
  items         String // descripción de las prendas
  fechaEntrega  DateTime    @map("fecha_entrega") @db.Date
  recibidoDocId String?     @map("recibido_doc_id") @db.Uuid
  // Firma digital del colaborador sobre el recibido (desde su autoservicio)
  firmadoEn     DateTime?   @map("firmado_en")
  creadoEn      DateTime    @default(now()) @map("creado_en")

  @@index([colaboradorId])
  @@map("entrega_dotacion")
}

enum TipoCapacitacion {
  INDUCCION
  REINDUCCION
  FORMACION
  SST

  @@map("tipo_capacitacion")
}

model Capacitacion {
  id          String           @id @default(uuid(7)) @db.Uuid
  titulo      String
  tipo        TipoCapacitacion @default(FORMACION)
  fecha       DateTime         @db.Date
  duracionHoras Decimal?       @map("duracion_horas") @db.Decimal(5, 1)
  facilitador String?
  descripcion String?
  creadoEn    DateTime         @default(now()) @map("creado_en")

  asistencias AsistenciaCapacitacion[]

  @@map("capacitacion")
}

model AsistenciaCapacitacion {
  id             String       @id @default(uuid(7)) @db.Uuid
  capacitacionId String       @map("capacitacion_id") @db.Uuid
  capacitacion   Capacitacion @relation(fields: [capacitacionId], references: [id], onDelete: Cascade)
  colaboradorId  String       @map("colaborador_id") @db.Uuid
  colaborador    Colaborador  @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  asistio        Boolean      @default(true)
  evaluacion     Decimal?     @db.Decimal(5, 2) // nota de la evaluación de la capacitación

  @@unique([capacitacionId, colaboradorId])
  @@map("asistencia_capacitacion")
}

model EvaluacionDesempeno {
  id            String      @id @default(uuid(7)) @db.Uuid
  colaboradorId String      @map("colaborador_id") @db.Uuid
  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  periodo       String // "2026-S1"
  evaluadorId   String?     @map("evaluador_id") @db.Uuid
  puntaje       Decimal     @db.Decimal(5, 2) // 0-100
  fortalezas    String?
  oportunidades String?
  compromisos   String?
  fecha         DateTime    @db.Date
  creadoEn      DateTime    @default(now()) @map("creado_en")

  @@index([colaboradorId])
  @@map("evaluacion_desempeno")
}

// ═══════════════════════════════════════════════════════════════════════════
// JURÍDICA (requerimiento 4) — documentos legales, disciplinarios, denuncias,
// habeas data y calendario de obligaciones legales
// ═══════════════════════════════════════════════════════════════════════════

enum CategoriaDocLegal {
  REGLAMENTO_INTERNO
  POLITICA
  CONVENIO_FINANCIERA
  POLIZA
  ARRIENDO
  MARCA
  DOMINIO_WEB
  LICENCIA_SOFTWARE
  ACUERDO_TRANSMISION_DATOS
  PERMISO_ESTABLECIMIENTO
  OTRO

  @@map("categoria_doc_legal")
}

// Documento legal con versionado y vigencia (los que tienen vigenciaFin publican Vencimiento)
model DocumentoLegal {
  id          String            @id @default(uuid(7)) @db.Uuid
  categoria   CategoriaDocLegal
  titulo      String
  descripcion String?
  vigenciaInicio DateTime?      @map("vigencia_inicio") @db.Date
  vigenciaFin DateTime?         @map("vigencia_fin") @db.Date
  sedeId      String?           @map("sede_id") @db.Uuid
  documentoId String?           @map("documento_id") @db.Uuid // archivo PDF
  // Marca este documento como la política del SG-SST (se refleja en el semáforo de SST)
  esSgSst     Boolean           @default(false) @map("es_sgsst")
  firmadaEn   DateTime?         @map("firmada_en") @db.Date // fecha de firma del representante legal
  creadoEn    DateTime          @default(now()) @map("creado_en")
  actualizadoEn DateTime        @updatedAt @map("actualizado_en")

  versiones VersionDocumentoLegal[]

  @@index([categoria])
  @@map("documento_legal")
}

model VersionDocumentoLegal {
  id               String         @id @default(uuid(7)) @db.Uuid
  documentoLegalId String         @map("documento_legal_id") @db.Uuid
  documentoLegal   DocumentoLegal @relation(fields: [documentoLegalId], references: [id], onDelete: Cascade)
  version          Int
  vigente          Boolean        @default(true)
  archivoDocId     String?        @map("archivo_doc_id") @db.Uuid
  cambios          String?
  creadoEn         DateTime       @default(now()) @map("creado_en")

  @@unique([documentoLegalId, version])
  @@map("version_documento_legal")
}

enum EtapaDisciplinaria {
  CITACION_DESCARGOS
  DESCARGOS
  DECISION
  RECURSO
  CERRADO

  @@map("etapa_disciplinaria")
}

/// Llamado de atencion: medida correctiva, NO una sancion.
/// A diferencia del proceso disciplinario no abre descargos ni plazos: su valor
/// es quedar como antecedente que demuestre que la falta fue reiterada. Por eso
/// se registra y se notifica, pero no exige firma del colaborador.
model LlamadoAtencion {
  id            String              @id @default(uuid(7)) @db.Uuid
  colaboradorId String              @map("colaborador_id") @db.Uuid
  colaborador   Colaborador         @relation(fields: [colaboradorId], references: [id])
  tipo          TipoLlamadoAtencion
  motivo        String
  detalle       String?
  fecha         DateTime            @db.Date
  creadoPorId   String?             @map("creado_por_id")
  creadoEn      DateTime            @default(now()) @map("creado_en")
  actualizadoEn DateTime            @updatedAt @map("actualizado_en")

  @@index([colaboradorId, fecha])
  @@map("llamado_atencion")
}

enum TipoLlamadoAtencion {
  VERBAL
  ESCRITO

  @@map("tipo_llamado_atencion")
}

model ProcesoDisciplinario {
  id            String             @id @default(uuid(7)) @db.Uuid
  colaboradorId String             @map("colaborador_id") @db.Uuid
  colaborador   Colaborador        @relation(fields: [colaboradorId], references: [id])
  asunto        String
  descripcion   String?
  etapa         EtapaDisciplinaria @default(CITACION_DESCARGOS)
  fechaApertura DateTime           @map("fecha_apertura") @db.Date
  decision      String?
  cerrado       Boolean            @default(false)
  fechaLimite   DateTime?          @map("fecha_limite") @db.Date // plazo vigente (descargos o apelación): 5 días hábiles
  documentoActaId String?          @map("documento_acta_id") @db.Uuid // acta/acuerdo final
  creadoEn      DateTime           @default(now()) @map("creado_en")
  actualizadoEn DateTime           @updatedAt @map("actualizado_en")

  etapas EtapaProceso[]
  terminaciones Terminacion[]

  @@index([colaboradorId])
  @@map("proceso_disciplinario")
}

model EtapaProceso {
  id        String               @id @default(uuid(7)) @db.Uuid
  procesoId String               @map("proceso_id") @db.Uuid
  proceso   ProcesoDisciplinario @relation(fields: [procesoId], references: [id], onDelete: Cascade)
  etapa     EtapaDisciplinaria
  fecha     DateTime             @db.Date
  detalle   String?
  documentoId String?            @map("documento_id") @db.Uuid
  creadoEn  DateTime             @default(now()) @map("creado_en")

  @@index([procesoId])
  @@map("etapa_proceso")
}

enum EstadoDenuncia {
  RECIBIDA
  EN_INVESTIGACION
  RESUELTA
  ARCHIVADA

  @@map("estado_denuncia")
}

// Canal de denuncias anti-acoso (acceso restringido a Comité de Convivencia/Jurídica)
model DenunciaAcoso {
  id          String         @id @default(uuid(7)) @db.Uuid
  codigo      String         @unique // código anónimo para seguimiento
  anonima     Boolean        @default(true)
  denuncianteNombre String?  @map("denunciante_nombre")
  hechos      String
  fechaHechos DateTime?      @map("fecha_hechos") @db.Date
  sedeId      String?        @map("sede_id") @db.Uuid
  estado      EstadoDenuncia @default(RECIBIDA)
  resolucion  String?
  documentoResolucionId String? @map("documento_resolucion_id") @db.Uuid // acuerdo/resolución final
  creadoEn    DateTime       @default(now()) @map("creado_en")
  actualizadoEn DateTime     @updatedAt @map("actualizado_en")

  @@map("denuncia_acoso")
}

// Habeas data (Ley 1581): autorización de tratamiento por persona
model AutorizacionDatos {
  id            String      @id @default(uuid(7)) @db.Uuid
  colaboradorId String      @map("colaborador_id") @db.Uuid
  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  fechaAutorizacion DateTime @map("fecha_autorizacion") @db.Date
  finalidad     String
  documentoId   String?     @map("documento_id") @db.Uuid
  revocada      Boolean     @default(false)
  creadoEn      DateTime    @default(now()) @map("creado_en")

  @@index([colaboradorId])
  @@map("autorizacion_datos")
}

enum TipoConsultaReclamo {
  CONSULTA
  RECLAMO
}

enum EstadoConsultaReclamo {
  ABIERTO
  EN_TRAMITE
  RESUELTO
}

model ConsultaReclamoDatos {
  id           String                @id @default(uuid(7)) @db.Uuid
  tipo         TipoConsultaReclamo
  titular      String
  // Colaborador que la radicó desde su autoservicio (null si la registró un tercero vía admin)
  colaboradorId String?              @map("colaborador_id") @db.Uuid
  colaborador   Colaborador?         @relation(fields: [colaboradorId], references: [id])
  descripcion  String
  fechaRadicacion DateTime           @map("fecha_radicacion") @db.Date
  fechaLimite  DateTime?             @map("fecha_limite") @db.Date
  estado       EstadoConsultaReclamo @default(ABIERTO)
  respuesta    String?
  creadoEn     DateTime              @default(now()) @map("creado_en")

  @@map("consulta_reclamo_datos")
}

enum PeriodicidadObligacion {
  MENSUAL
  BIMESTRAL
  CUATRIMESTRAL
  SEMESTRAL
  ANUAL
  CADA_N_ANIOS
  POR_EVENTO

  @@map("periodicidad_obligacion")
}

enum CategoriaObligacion {
  SOCIETARIO
  TRIBUTARIO
  LABORAL
  HABEAS_DATA
  COMERCIAL
  SST
  CONTRACTUAL

  @@map("categoria_obligacion")
}

model ObligacionLegal {
  id             String                 @id @default(uuid(7)) @db.Uuid
  nombre         String
  categoria      CategoriaObligacion
  periodicidad   PeriodicidadObligacion
  descripcion    String?
  responsableRol String?                @map("responsable_rol")
  porSede        Boolean                @default(false) @map("por_sede") // ICA, matrícula por sede
  cadaNAnios     Int?                   @map("cada_n_anios")
  // Fecha base de vencimiento: mes (1-12) y día. Para mensual, diaBase = día del mes.
  // Para semestral, mesesBase guarda los meses (ej. [2,8]) separados por coma.
  mesBase        Int?                   @map("mes_base")
  diaBase        Int?                   @map("dia_base")
  mesesBase      String?                @map("meses_base") // "2,8" para semestral
  fuenteLegal    String?                @map("fuente_legal")
  activa         Boolean                @default(true)
  creadoEn       DateTime               @default(now()) @map("creado_en")

  ocurrencias OcurrenciaObligacion[]

  @@map("obligacion_legal")
}

enum EstadoOcurrencia {
  PENDIENTE
  CUMPLIDA
  VENCIDA

  @@map("estado_ocurrencia")
}

model OcurrenciaObligacion {
  id            String           @id @default(uuid(7)) @db.Uuid
  obligacionId  String           @map("obligacion_id") @db.Uuid
  obligacion    ObligacionLegal  @relation(fields: [obligacionId], references: [id], onDelete: Cascade)
  fechaLimite   DateTime         @map("fecha_limite") @db.Date
  sedeId        String?          @map("sede_id") @db.Uuid
  estado        EstadoOcurrencia @default(PENDIENTE)
  fechaCumplido DateTime?        @map("fecha_cumplido") @db.Date
  evidenciaDocId String?         @map("evidencia_doc_id") @db.Uuid
  observaciones String?
  creadoEn      DateTime         @default(now()) @map("creado_en")

  @@index([obligacionId, fechaLimite])
  @@index([estado, fechaLimite])
  @@map("ocurrencia_obligacion")
}

// ═══════════════════════════════════════════════════════════════════════════
// SST — SG-SST (Decreto 1072/2015, Resolución 0312/2019) — requerimiento 5
// ═══════════════════════════════════════════════════════════════════════════

enum TipoComite {
  VIGIA_SST
  COPASST
  CONVIVENCIA

  @@map("tipo_comite")
}

model Comite {
  id               String     @id @default(uuid(7)) @db.Uuid
  tipo             TipoComite
  fechaConformacion DateTime  @map("fecha_conformacion") @db.Date
  vigenciaHasta    DateTime   @map("vigencia_hasta") @db.Date // 2 años
  sedeId           String?    @map("sede_id") @db.Uuid
  activo           Boolean    @default(true)
  creadoEn         DateTime   @default(now()) @map("creado_en")

  miembros  MiembroComite[]
  reuniones ReunionComite[]

  @@map("comite")
}

model MiembroComite {
  id            String  @id @default(uuid(7)) @db.Uuid
  comiteId      String  @map("comite_id") @db.Uuid
  comite        Comite  @relation(fields: [comiteId], references: [id], onDelete: Cascade)
  colaboradorId String      @map("colaborador_id") @db.Uuid
  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id])
  rol           String // Presidente, Secretario, Miembro, Suplente
  porEmpleador  Boolean     @default(false) @map("por_empleador")

  @@index([colaboradorId])
  @@map("miembro_comite")
}

model ReunionComite {
  id          String   @id @default(uuid(7)) @db.Uuid
  comiteId    String   @map("comite_id") @db.Uuid
  comite      Comite   @relation(fields: [comiteId], references: [id], onDelete: Cascade)
  fecha       DateTime @db.Date
  temas       String
  compromisos String?
  actaDocId   String?  @map("acta_doc_id") @db.Uuid
  creadoEn    DateTime @default(now()) @map("creado_en")

  @@index([comiteId])
  @@map("reunion_comite")
}

enum NivelRiesgoIpevr {
  BAJO
  MEDIO
  ALTO
  CRITICO

  @@map("nivel_riesgo_ipevr")
}

model PeligroIpevr {
  id               String           @id @default(uuid(7)) @db.Uuid
  sedeId           String?          @map("sede_id") @db.Uuid
  proceso          String
  peligro          String
  riesgo           String
  nivel            NivelRiesgoIpevr
  controles        String?
  // Campos GTC 45: rutina de la tarea y jerarquía de controles existentes.
  rutinaria        Boolean          @default(true)
  controlFuente    String?          @map("control_fuente")
  controlMedio     String?          @map("control_medio")
  controlIndividuo String?          @map("control_individuo")
  responsable      String?
  fechaRevision    DateTime?        @map("fecha_revision") @db.Date
  creadoEn         DateTime         @default(now()) @map("creado_en")

  @@map("peligro_ipevr")
}

model Profesiograma {
  id                  String   @id @default(uuid(7)) @db.Uuid
  cargoId             String   @unique @map("cargo_id") @db.Uuid
  riesgosExpuestos    String   @map("riesgos_expuestos")
  examenesRequeridos  String   @map("examenes_requeridos")
  aptitudesRequeridas String   @map("aptitudes_requeridas")
  restricciones       String?
  creadoEn            DateTime @default(now()) @map("creado_en")
  actualizadoEn       DateTime @updatedAt @map("actualizado_en")

  @@map("profesiograma")
}

model PlanEmergencia {
  id            String   @id @default(uuid(7)) @db.Uuid
  sedeId        String?  @map("sede_id") @db.Uuid
  version       String
  vigenciaDesde DateTime @map("vigencia_desde") @db.Date
  vigenciaHasta DateTime @map("vigencia_hasta") @db.Date
  documentoId   String?  @map("documento_id") @db.Uuid
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now()) @map("creado_en")

  @@map("plan_emergencia")
}

model Brigadista {
  id            String      @id @default(uuid(7)) @db.Uuid
  colaboradorId String      @map("colaborador_id") @db.Uuid
  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id])
  sedeId        String?     @map("sede_id") @db.Uuid
  rol           String // Evacuación, Primeros auxilios, Contraincendios, Comunicaciones
  activo        Boolean     @default(true)
  creadoEn      DateTime    @default(now()) @map("creado_en")

  @@index([colaboradorId])
  @@map("brigadista")
}

model Simulacro {
  id            String   @id @default(uuid(7)) @db.Uuid
  sedeId        String?  @map("sede_id") @db.Uuid
  fecha         DateTime @db.Date
  tipo          String // Incendio, Sismo, Evacuación…
  participantes Int?
  observaciones String?
  documentoId   String?  @map("documento_id") @db.Uuid
  creadoEn      DateTime @default(now()) @map("creado_en")

  @@map("simulacro")
}

enum EstadoInspeccion {
  ABIERTA
  CERRADA

  @@map("estado_inspeccion")
}

model InspeccionSst {
  id          String           @id @default(uuid(7)) @db.Uuid
  sedeId      String?          @map("sede_id") @db.Uuid
  fecha       DateTime         @db.Date
  tipo        String // Locativa, Extintores, Equipos, Ergonómica…
  area        String?
  hallazgos   String
  responsable String?
  estado      EstadoInspeccion @default(ABIERTA)
  fechaCierre DateTime?        @map("fecha_cierre") @db.Date
  documentoId String?          @map("documento_id") @db.Uuid
  creadoEn    DateTime         @default(now()) @map("creado_en")

  @@map("inspeccion_sst")
}

enum TipoExamenMedico {
  INGRESO
  PERIODICO
  EGRESO
  POST_INCAPACIDAD

  @@map("tipo_examen_medico")
}

enum ConceptoExamen {
  APTO
  APTO_CON_RECOMENDACIONES
  NO_APTO
  APLAZADO

  @@map("concepto_examen")
}

// Datos clínicos sensibles (Ley 1581) — acceso con permiso colaboradores_salud / SST
model ExamenMedico {
  id              String           @id @default(uuid(7)) @db.Uuid
  colaboradorId   String           @map("colaborador_id") @db.Uuid
  colaborador     Colaborador      @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  tipo            TipoExamenMedico
  fecha           DateTime         @db.Date
  fechaVencimiento DateTime?       @map("fecha_vencimiento") @db.Date // periódicos → alerta
  concepto        ConceptoExamen   @default(APTO)
  recomendaciones String? // dato clínico sensible
  restricciones   String? // dato clínico sensible
  documentoId     String?          @map("documento_id") @db.Uuid
  creadoEn        DateTime         @default(now()) @map("creado_en")

  // Seguimiento a recomendaciones/restricciones: abierto mientras haya algo que vigilar
  seguimientoCerrado Boolean       @default(false) @map("seguimiento_cerrado")
  seguimientos    SeguimientoExamen[]

  @@index([colaboradorId])
  @@map("examen_medico")
}

// Notas de seguimiento a las recomendaciones/restricciones de un examen
// (dato clínico sensible — visible solo con permiso colaboradores_salud).
model SeguimientoExamen {
  id       String       @id @default(uuid(7)) @db.Uuid
  examenId String       @map("examen_id") @db.Uuid
  examen   ExamenMedico @relation(fields: [examenId], references: [id], onDelete: Cascade)
  fecha    DateTime     @db.Date
  nota     String
  creadoEn DateTime     @default(now()) @map("creado_en")

  @@index([examenId])
  @@map("seguimiento_examen")
}

enum TipoNovedadArl {
  AFILIACION
  RETIRO
  TRASLADO_ARL
  CAMBIO_CLASE_RIESGO
  OTRA

  @@map("tipo_novedad_arl")
}

// Novedades reportadas a la ARL (afiliaciones, retiros, traslados, cambios de clase de riesgo)
model NovedadArl {
  id            String         @id @default(uuid(7)) @db.Uuid
  colaboradorId String         @map("colaborador_id") @db.Uuid
  colaborador   Colaborador    @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  tipo          TipoNovedadArl
  fecha         DateTime       @db.Date
  detalle       String?
  claseRiesgo   ClaseRiesgoArl? @map("clase_riesgo") // para cambios de clase
  soporteDocId  String?        @map("soporte_doc_id") @db.Uuid
  creadoEn      DateTime       @default(now()) @map("creado_en")

  @@index([colaboradorId])
  @@map("novedad_arl")
}

enum EstadoAccidente {
  REPORTADO
  EN_INVESTIGACION
  CERRADO

  @@map("estado_accidente")
}

model AccidenteTrabajo {
  id            String          @id @default(uuid(7)) @db.Uuid
  colaboradorId String          @map("colaborador_id") @db.Uuid
  colaborador   Colaborador     @relation(fields: [colaboradorId], references: [id])
  fecha         DateTime        @db.Date
  hora          String?
  sedeId        String?         @map("sede_id") @db.Uuid
  descripcion   String
  parteCuerpo   String?         @map("parte_cuerpo")
  diasIncapacidad Int?          @map("dias_incapacidad")
  // Incidente = casi-accidente sin lesión (Res. 1401/2007): se investiga igual,
  // pero no se reporta a la ARL (sin FURAT) ni suma a los índices de accidentalidad.
  esIncidente   Boolean         @default(false) @map("es_incidente")
  furatReportado Boolean        @default(false) @map("furat_reportado")
  investigacion String?
  estado        EstadoAccidente @default(REPORTADO)
  creadoEn      DateTime        @default(now()) @map("creado_en")

  @@index([colaboradorId])
  @@map("accidente_trabajo")
}

model ElementoEpp {
  id       String  @id @default(uuid(7)) @db.Uuid
  nombre   String  @unique
  vidaUtilMeses Int? @map("vida_util_meses")
  activo   Boolean @default(true)

  entregas EntregaEpp[]

  @@map("elemento_epp")
}

model EntregaEpp {
  id            String      @id @default(uuid(7)) @db.Uuid
  elementoEppId String      @map("elemento_epp_id") @db.Uuid
  elementoEpp   ElementoEpp @relation(fields: [elementoEppId], references: [id])
  colaboradorId String      @map("colaborador_id") @db.Uuid
  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  cantidad      Int         @default(1)
  fechaEntrega  DateTime    @map("fecha_entrega") @db.Date
  reposicion    Boolean     @default(false)
  soporteDocId  String?     @map("soporte_doc_id") @db.Uuid
  // Firma digital del colaborador sobre el recibido (desde su autoservicio)
  firmadoEn     DateTime?   @map("firmado_en")
  creadoEn      DateTime    @default(now()) @map("creado_en")

  @@index([colaboradorId])
  @@map("entrega_epp")
}

model AutoevaluacionSst {
  id            String   @id @default(uuid(7)) @db.Uuid
  anio          Int
  puntaje       Decimal  @db.Decimal(5, 2) // 0-100
  nivelEstandar Int      @map("nivel_estandar") // 7, 21 o 60 estándares
  planMejora    String?  @map("plan_mejora")
  documentoId   String?  @map("documento_id") @db.Uuid
  creadoEn      DateTime @default(now()) @map("creado_en")

  @@unique([anio])
  @@map("autoevaluacion_sst")

  acciones AccionMejoraSst[]
}

// Plan de mejoramiento tras la autoevaluación (Res. 0312/2019 art. 28): cada
// acción con responsable, fecha límite y evidencia; alerta al acercarse el plazo.
model AccionMejoraSst {
  id               String            @id @default(uuid(7)) @db.Uuid
  autoevaluacionId String            @map("autoevaluacion_id") @db.Uuid
  autoevaluacion   AutoevaluacionSst @relation(fields: [autoevaluacionId], references: [id], onDelete: Cascade)
  actividad        String
  responsable      String
  fechaLimite      DateTime          @map("fecha_limite") @db.Date
  recursos         String?
  cumplida         Boolean           @default(false)
  cumplidaEn       DateTime?         @map("cumplida_en") @db.Date
  evidenciaDocId   String?           @map("evidencia_doc_id") @db.Uuid
  creadoEn         DateTime          @default(now()) @map("creado_en")

  @@index([autoevaluacionId])
  @@map("accion_mejora_sst")
}

// Indicadores SST mensuales (frecuencia, severidad, ausentismo)
model IndicadorSst {
  id              String   @id @default(uuid(7)) @db.Uuid
  anio            Int
  mes             Int
  numTrabajadores Int      @map("num_trabajadores")
  horasHombre     Decimal  @map("horas_hombre") @db.Decimal(12, 2)
  numAccidentes   Int      @default(0) @map("num_accidentes")
  diasPerdidos    Int      @default(0) @map("dias_perdidos")
  diasAusentismo  Int      @default(0) @map("dias_ausentismo")
  creadoEn        DateTime @default(now()) @map("creado_en")

  @@unique([anio, mes])
  @@map("indicador_sst")
}

// Estructura documental del SG-SST (D.1072 art. 2.2.4.6.8): responsable designado.
// Histórico: el vigente es el registro activo más reciente.
model ResponsableSgsst {
  id               String      @id @default(uuid(7)) @db.Uuid
  colaboradorId    String      @map("colaborador_id") @db.Uuid
  colaborador      Colaborador @relation(fields: [colaboradorId], references: [id])
  fechaDesignacion DateTime    @map("fecha_designacion") @db.Date
  licenciaSst      String?     @map("licencia_sst") // nro. de licencia en SST (si aplica)
  cursoHoras       Int?        @map("curso_horas") // curso virtual 50 o 20 horas
  cartaDocId       String?     @map("carta_doc_id") @db.Uuid // carta de designación firmada
  activo           Boolean     @default(true)
  creadoEn         DateTime    @default(now()) @map("creado_en")

  @@index([colaboradorId])
  @@map("responsable_sgsst")
}

// Plan de trabajo anual del SG-SST (D.1072 art. 2.2.4.6.8 num. 7): uno por año.
model PlanTrabajoSst {
  id          String   @id @default(uuid(7)) @db.Uuid
  anio        Int
  documentoId String?  @map("documento_id") @db.Uuid // PDF del plan firmado
  aprobadoPor String?  @map("aprobado_por") // quién lo aprueba (empleador/representante)
  avancePct   Int      @default(0) @map("avance_pct") // % de ejecución (0-100)
  notas       String?
  creadoEn    DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  @@unique([anio])
  @@map("plan_trabajo_sst")
}

enum CumplimientoNorma {
  CUMPLE
  PARCIAL
  NO_CUMPLE

  @@map("cumplimiento_norma")
}

// Matriz legal SST (normograma, D.1072 art. 2.2.4.6.8 num. 5): inventario de
// normas aplicables con evaluación de cumplimiento y evidencia.
model NormaMatrizLegal {
  id             String            @id @default(uuid(7)) @db.Uuid
  norma          String // ej. "Decreto 1072 de 2015"
  emisor         String? // Ministerio del Trabajo, etc.
  tema           String // qué regula frente a la empresa
  articulos      String? // artículos aplicables
  comoCumple     String?           @map("como_cumple")
  cumplimiento   CumplimientoNorma @default(NO_CUMPLE)
  evidenciaDocId String?           @map("evidencia_doc_id") @db.Uuid
  responsableRol String?           @map("responsable_rol")
  activo         Boolean           @default(true)
  creadoEn       DateTime          @default(now()) @map("creado_en")
  actualizadoEn  DateTime          @updatedAt @map("actualizado_en")

  @@map("norma_matriz_legal")
}

// ═══════════════════════════════════════════════════════════════════════════
// MÓDULOS PERSONALIZADOS — el Administrador crea pestañas/módulos (requerimiento 1)
// ═══════════════════════════════════════════════════════════════════════════

enum VinculoModulo {
  GLOBAL
  POR_COLABORADOR
  POR_SEDE

  @@map("vinculo_modulo")
}

model ModuloPersonalizado {
  id          String        @id @default(uuid(7)) @db.Uuid
  slug        String        @unique // clave para permisos custom:{slug}
  nombre      String
  icono       String        @default("Layers")
  seccion     String        @default("Personalizados")
  vinculo     VinculoModulo @default(GLOBAL)
  descripcion String?
  activo      Boolean       @default(true)
  orden       Int           @default(100)
  creadoEn    DateTime      @default(now()) @map("creado_en")

  campos    CampoPersonalizado[]
  registros RegistroPersonalizado[]

  @@map("modulo_personalizado")
}

enum TipoCampo {
  TEXTO
  TEXTO_LARGO
  NUMERO
  DECIMAL
  MONEDA
  FECHA
  OPCION
  SI_NO
  COLABORADOR

  @@map("tipo_campo")
}

model CampoPersonalizado {
  id           String              @id @default(uuid(7)) @db.Uuid
  moduloId     String              @map("modulo_id") @db.Uuid
  modulo       ModuloPersonalizado @relation(fields: [moduloId], references: [id], onDelete: Cascade)
  clave        String
  etiqueta     String
  tipo         TipoCampo
  requerido    Boolean             @default(false)
  opciones     String? // para OPCION: valores separados por coma
  generaAlerta Boolean             @default(false) @map("genera_alerta") // FECHA → vencimiento
  mostrarEnTabla Boolean           @default(true) @map("mostrar_en_tabla")
  orden        Int                 @default(100)

  @@unique([moduloId, clave])
  @@map("campo_personalizado")
}

model RegistroPersonalizado {
  id            String              @id @default(uuid(7)) @db.Uuid
  moduloId      String              @map("modulo_id") @db.Uuid
  modulo        ModuloPersonalizado @relation(fields: [moduloId], references: [id], onDelete: Cascade)
  colaboradorId String?             @map("colaborador_id") @db.Uuid
  sedeId        String?             @map("sede_id") @db.Uuid
  datos         Json // { clave: valor }
  creadoEn      DateTime            @default(now()) @map("creado_en")
  actualizadoEn DateTime            @updatedAt @map("actualizado_en")

  @@index([moduloId])
  @@map("registro_personalizado")
}
