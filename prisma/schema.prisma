enum TipoSolicitud {
  VACACIONES
  PERMISO
  INCAPACIDAD
  CERTIFICACION_LABORAL
  LICENCIA
  OTRA

  @@map("tipo_solicitud")
}

enum EstadoSolicitud {
  PENDIENTE
  EN_APROBACION
  // Contrapropuesta de fechas del jefe pendiente de respuesta del colaborador
  // (RIT art. 29 lit. c: el disfrute de vacaciones se concierta entre ambos).
  EN_NEGOCIACION
  // Licencia de ley con soporte insuficiente: vuelve al colaborador para que lo
  // corrija sobre la MISMA solicitud (no es un rechazo; la licencia es un derecho).
  DEVUELTA
  APROBADA
  RECHAZADA
  CANCELADA

  @@map("estado_solicitud")
}

model Solicitud {
  id            String          @id @default(uuid(7)) @db.Uuid
  colaboradorId String          @map("colaborador_id") @db.Uuid
  colaborador   Colaborador     @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  tipo          TipoSolicitud
  datos         Json // contenido específico (fechas de vacaciones, tipo de certificación…)
  estado        EstadoSolicitud @default(EN_APROBACION)
  resultado     String? // referencia al objeto creado o motivo de rechazo
  creadoEn      DateTime        @default(now()) @map("creado_en")
  actualizadoEn DateTime        @updatedAt @map("actualizado_en")

  pasos PasoAprobacion[]

  @@index([colaboradorId, estado])
  @@index([estado])
  @@map("solicitud")
}

enum EstadoPasoAprobacion {
  PENDIENTE
  APROBADO
  RECHAZADO
  OMITIDO

  @@map("estado_paso_aprobacion")
}

model PasoAprobacion {
