// NOTIFICACIONES — centro in-app + outbox (correo / WhatsApp preparado)
// ═══════════════════════════════════════════════════════════════════════════

// Suscripción Web Push de un dispositivo (navegador/PWA) de un usuario.
model SuscripcionPush {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?  @map("user_agent")
  creadoEn  DateTime @default(now()) @map("creado_en")

  @@index([userId])
  @@map("suscripcion_push")
}

model Notificacion {
  id          String   @id @default(uuid(7)) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  titulo      String
  mensaje     String
  enlace      String?
  leida       Boolean  @default(false)
  // Clave del evento (ver src/lib/notificaciones/catalogo.ts). Permite que el
  // admin configure qué eventos muestran pop-up. Null = aviso sin catalogar.
  evento      String?
  // Evita duplicar la misma notificación si el cron corre dos veces
  dedupeKey   String   @unique @map("dedupe_key")
  creadoEn    DateTime @default(now()) @map("creado_en")

  @@index([userId, leida, creadoEn])
  @@map("notificacion")
}

// Preferencia global (la fija el administrador) de qué eventos muestran pop-up.
// Sin registro para un evento = pop-up activo por defecto. Solo afecta el pop-up
// (toast): la notificación igual llega a la campana, el correo y el push.
model PreferenciaNotificacion {
  evento        String   @id
  popup         Boolean  @default(true)
  // Si además del aviso en la app se manda correo. Sin fila, manda el valor por
  // defecto del catálogo (src/lib/notificaciones/catalogo.ts), que es NO salvo
  // donde corre un plazo legal.
  correo        Boolean  @default(false)
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  @@map("preferencia_notificacion")
}

enum CanalMensaje {
  EMAIL
  WHATSAPP

  @@map("canal_mensaje")
}

enum EstadoMensaje {
  EN_COLA
  ENVIADO
  FALLIDO
  DESCARTADO

  @@map("estado_mensaje")
}

// Outbox de mensajes salientes (idempotente por dedupeKey, con reintentos)
model MensajeSaliente {
  id          String        @id @default(uuid(7)) @db.Uuid
  canal       CanalMensaje
  destino     String // email o teléfono E.164
  asunto      String?
  cuerpo      String
  estado      EstadoMensaje @default(EN_COLA)
  intentos    Int           @default(0)
  proveedorRef String?      @map("proveedor_ref")
  error       String?
  dedupeKey   String        @unique @map("dedupe_key")
  creadoEn    DateTime      @default(now()) @map("creado_en")
  enviadoEn   DateTime?     @map("enviado_en")

  @@index([estado])
  @@map("mensaje_saliente")
}

// ═══════════════════════════════════════════════════════════════════════════
// CONTRATACIÓN LABORAL (requerimiento 3.2 / 6.3)
// ═══════════════════════════════════════════════════════════════════════════

enum TipoContratoLaboral {
  TERMINO_FIJO
  TERMINO_INDEFINIDO
  OBRA_LABOR
  APRENDIZAJE_SENA
  PRACTICA

  @@map("tipo_contrato_laboral")
}

enum TipoSalario {
  ORDINARIO
  INTEGRAL

  @@map("tipo_salario")
}

enum Jornada {
  TIEMPO_COMPLETO
  MEDIO_TIEMPO
  POR_DIAS

  @@map("jornada")
}

enum EstadoContrato {
  BORRADOR
  ACTIVO
  SUSPENDIDO
  TERMINADO

  @@map("estado_contrato")
}

enum EtapaAprendizaje {
  LECTIVA
  PRODUCTIVA

  @@map("etapa_aprendizaje")
}

model Contrato {
  id                 String              @id @default(uuid(7)) @db.Uuid
  numero             String              @unique
  colaboradorId      String              @map("colaborador_id") @db.Uuid
  colaborador        Colaborador         @relation(fields: [colaboradorId], references: [id])
  tipo               TipoContratoLaboral
  cargoId            String?             @map("cargo_id") @db.Uuid
  cargo              Cargo?              @relation(fields: [cargoId], references: [id])
  sedeId             String              @map("sede_id") @db.Uuid
  sede               Sede                @relation(fields: [sedeId], references: [id])
  jornada            Jornada             @default(TIEMPO_COMPLETO)
  horasSemanales     Int?                @map("horas_semanales")
  modalidadTrabajo   ModalidadTrabajo    @map("modalidad_trabajo")
  salarioBase        Decimal             @map("salario_base") @db.Decimal(14, 2)
  ganaSalarioMinimo  Boolean             @default(false) @map("gana_salario_minimo") // salario = SMMLV vigente (se actualiza con el parámetro)
  tieneAuxTransporte Boolean             @default(true) @map("tiene_aux_transporte") // aplica auxilio de transporte si es elegible (≤2 SMMLV, ordinario)
  auxConectividad    Decimal?            @map("aux_conectividad") @db.Decimal(14, 2) // auxilio de conectividad (valor manual, no constitutivo)
  tipoSalario        TipoSalario         @default(ORDINARIO) @map("tipo_salario")
  fechaInicio        DateTime            @map("fecha_inicio") @db.Date
  fechaFin           DateTime?           @map("fecha_fin") @db.Date
  objetoObraLabor    String?             @map("objeto_obra_labor")
  etapaAprendizaje   EtapaAprendizaje?   @map("etapa_aprendizaje")
  apoyoSostenimiento Decimal?            @map("apoyo_sostenimiento") @db.Decimal(14, 2)
  periodoPruebaDias  Int?                @map("periodo_prueba_dias")
  periodoPruebaFin   DateTime?           @map("periodo_prueba_fin") @db.Date
  estado             EstadoContrato      @default(BORRADOR)
  observaciones      String?
  // Snapshot de los datos resueltos del PDF (plantilla + variables sustituidas) para
  // regenerar el documento firmado sin re-derivar; el texto queda congelado al crear.
  contenidoPdf       Json?               @map("contenido_pdf")
  // Origen del PDF: GENERADO (desde plantilla in-app) o SUBIDO (contrato ya existente,
  // normalmente firmado en físico; se adjunta como Documento y se omite la firma digital).
  origenPdf          OrigenPdfContrato   @default(GENERADO) @map("origen_pdf")
  // Firma digital de cada parte (imagen PNG en storage) + fecha y usuario que la aplicó.
  firmaEmpleadoPath   String?   @map("firma_empleado_path")
  firmaEmpleadoFecha  DateTime? @map("firma_empleado_fecha")
  firmaEmpleadoPorId  String?   @map("firma_empleado_por_id") @db.Uuid
  firmaEmpleadorPath  String?   @map("firma_empleador_path")
  firmaEmpleadorFecha DateTime? @map("firma_empleador_fecha")
  firmaEmpleadorPorId String?   @map("firma_empleador_por_id") @db.Uuid
  creadoEn           DateTime            @default(now()) @map("creado_en")
  actualizadoEn      DateTime            @updatedAt @map("actualizado_en")

  prorrogas       ProrrogaContrato[]
  otrosis         OtrosiContrato[]
  suspensiones    SuspensionContrato[]
  evidenciasFirma EvidenciaFirmaContrato[]

  @@index([colaboradorId, estado])
  @@index([tipo, estado, fechaFin])
  @@index([sedeId])
  @@map("contrato")
}

model ProrrogaContrato {
  id          String    @id @default(uuid(7)) @db.Uuid
  contratoId  String    @map("contrato_id") @db.Uuid
  contrato    Contrato  @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  numero      Int
  fechaInicio DateTime  @map("fecha_inicio") @db.Date
  fechaFin    DateTime  @map("fecha_fin") @db.Date
  fechaFirma  DateTime? @map("fecha_firma") @db.Date
